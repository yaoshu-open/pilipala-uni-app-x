<template>
	<view class="st" :style="pageStyle">
		<!-- 顶栏：← +「设置」（基线 P10_setting：返回+加粗标题，无右区） -->
		<app-navbar title="设置"></app-navbar>

		<scroll-view class="st-scroll" direction="vertical">
			<!-- 7 行纯文字列表（基线形态：无图标、无右值、无分割线、行距宽松；
			     退出登录不做红色区分（基线同款），仅登录态渲染（源 Visibility 同款） -->
			<view class="st-list">
				<view class="st-row" @click="go('/pages/setting/privacy-setting')">
					<text class="st-row-text" :style="rowTextStyle">隐私设置</text>
				</view>
				<view class="st-row" @click="go('/pages/setting/recommend-setting')">
					<text class="st-row-text" :style="rowTextStyle">推荐设置</text>
				</view>
				<view class="st-row" @click="go('/pages/setting/play-setting')">
					<text class="st-row-text" :style="rowTextStyle">播放设置</text>
				</view>
				<view class="st-row" @click="go('/pages/setting/style-setting')">
					<text class="st-row-text" :style="rowTextStyle">外观设置</text>
				</view>
				<view class="st-row" @click="go('/pages/setting/extra-setting')">
					<text class="st-row-text" :style="rowTextStyle">其他设置</text>
				</view>
				<view v-if="isLogin" class="st-row" @click="confirmLogout">
					<text class="st-row-text" :style="rowTextStyle">退出登录</text>
				</view>
				<view class="st-row" @click="goAbout">
					<text class="st-row-text" :style="rowTextStyle">关于</text>
				</view>
			</view>
			<view class="st-bottom"></view>
		</scroll-view>

		<!-- 退出登录确认弹层（源 SettingController.loginOut 的 AlertDialog：提示/点错了/确认） -->
		<!-- 常驻 + display 切换：App 端 v-if 转 false 不卸载节点（P8/P9 已复现） -->
		<view class="st-mask" :style="logoutMaskStyle" @click="closeLogout">
			<view class="st-dialog" :style="dialogStyle" @click.stop="noop">
				<text class="st-dialog-title" :style="titleStyle">提示</text>
				<text class="st-dialog-content" :style="secondaryStyle">确认要退出登录吗</text>
				<view class="st-dialog-actions">
					<view class="st-dialog-btn" @click.stop="closeLogout">
						<text class="st-dialog-cancel" :style="secondaryStyle">点错了</text>
					</view>
					<view class="st-dialog-btn" @click.stop="doLogout">
						<text class="st-dialog-ok" :style="okStyle">确认</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow, onBackPress } from '@dcloudio/uni-app'
import AppNavbar from '../../components/app-navbar/app-navbar.uvue'
import { pageBackground, cardBackground, textPrimary, textSecondary, themeColor, currentThemeIndex } from '../../utils/theme.uts'
import { safeAreaBottom } from '../../utils/safeArea.uts'
import { userState } from '../../stores/user.uts'
import { clearLogin, refreshLoginState, ensureLoginState } from '../../composables/useLogin.uts'
import { logWarn } from '../../utils/logger.uts'
import { clearAllCookies } from '../../utils/cookie.uts'
import { removeKey, CK } from '../../utils/storage.uts'

/**
 * 设置主页（源头：lib/pages/setting/view.dart）。
 *
 *  - 7 行列表基线形态：纯文字、左对齐、无图标/右值/分割线（标题 titleMedium 16px w500、
 *    dense=false 行高宽松）；
 *  - 退出登录：仅 userState.isLogin 时渲染（源 Visibility 同款；onShow 重读登录态——
 *    从子页返回时登录态可能已变化）；确认弹层文案逐字照源（提示/确认要退出登录吗/点错了/确认）；
 *  - 清理链（源 loginOut：清 cookie jar + userInfoCache + accessKey → 刷新登录态 → 返回）：
 *    新端等价 = clearAllCookies()（镜像 + 平台 jar，后者经 pl-cookie 插件清 CookieManager）+ 清
 *    CK.userInfoCache / CK.accessKey / CK.wbiKeys / CK.timeStamp + clearLogin()（内存态+缓存）→ 返回上一页；
 *    退出后以 nav 复核：登录态仍为 true 时如实提示，不假报「已退出」；
 *  - 关于：/pages/about/about（P11 批次页面，跳转 fail 兜底 toast，集成阶段对齐）。
 */

const isLogin = ref<boolean>(false)
const logoutVisible = ref<boolean>(false)

const primary: string = themeColor(currentThemeIndex())
const pageStyle = computed((): string => 'background-color:' + pageBackground() + ';')
const rowTextStyle = computed((): string => 'color:' + textPrimary() + ';')
const titleStyle: string = 'color:' + textPrimary() + ';'
const secondaryStyle: string = 'color:' + textSecondary() + ';'
const okStyle: string = 'color:' + primary + ';'
const dialogStyle: string = 'background-color:' + cardBackground() + ';'
const logoutMaskStyle = computed((): string => logoutVisible.value ? '' : 'display:none;')

function noop() {}

function go(url: string) {
	uni.navigateTo({
		url: url,
		fail: (_e) => {
			uni.showToast({ title: '页面未接入', icon: 'none' })
		}
	})
}

/** 关于页（源码 lib/pages/about/index.dart） */
function goAbout() {
	go('/pages/about/about')
}

function confirmLogout() {
	logoutVisible.value = true
}

function closeLogout() {
	logoutVisible.value = false
}

/**
 * 退出登录（源 loginOut 链路逆向）：
 *  清 cookie（镜像 + 平台 jar）→ 清 CK.userInfoCache / accessKey / wbiKeys / timeStamp → clearLogin() 重置内存态
 *  → **以 nav 复核真实登录态**（不假设清理生效）。
 *
 * 平台 jar 清理经 pl-cookie 插件（App-Android 调 CookieManager.removeAllCookies + flush）；
 * web / 小程序端无该能力，返回 false 时导航复核若仍为已登录，如实提示用户，不假报「已退出」。
 */
async function doLogout() {
	logoutVisible.value = false
	const jarCleared = clearAllCookies()
	removeKey(CK.userInfoCache)
	removeKey(CK.accessKey)
	removeKey(CK.wbiKeys)
	removeKey(CK.timeStamp)
	clearLogin()
	const stillLogin = await refreshLoginState()
	if (stillLogin) {
		logWarn('setting', 'logout verify: nav still isLogin=true (cookie jar cleared=' + jarCleared.toString() + ')')
		isLogin.value = true
		uni.showToast({ title: '登录态未完全清除，请重启应用后重试', icon: 'none' })
		return
	}
	userState.isLogin = false
	isLogin.value = false
	uni.showToast({ title: '已退出登录', icon: 'none' })
	setTimeout(() => {
		uni.navigateBack({ delta: 1 })
	}, 300)
}

// 浮层返回接管（页面级钩子；组件内无效）
onBackPress(() => {
	if (logoutVisible.value) {
		closeLogout()
		return true
	}
	return false
})

onShow((_e) => {
	// 登录态以 nav 复核（P8 教训：不要按内存标志预判——冷启动时 onLaunch 的 nav 可能还没回来）
	isLogin.value = userState.isLogin
	if (!isLogin.value) {
		ensureLoginState().then((logged: boolean) => {
			isLogin.value = logged
		})
	}
})
</script>

<style>
	.st {
		flex: 1;
		display: flex;
		flex-direction: column;
		position: relative;
	}
	.st-scroll {
		flex: 1;
	}
	.st-list {
		display: flex;
		flex-direction: column;
	}
	.st-row {
		min-height: 56px;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 16px;
		padding-right: 16px;
	}
	.st-row-text {
		font-size: 16px;
		font-weight: 500;
	}
	.st-bottom {
		height: 24px;
		padding-bottom: 0px;
	}
	/* 确认弹层（居中形态，源 AlertDialog） */
	.st-mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.st-dialog {
		width: 300px;
		border-radius: 14px;
		padding-left: 20px;
		padding-right: 20px;
		padding-top: 20px;
		padding-bottom: 10px;
		display: flex;
		flex-direction: column;
	}
	.st-dialog-title {
		font-size: 17px;
		font-weight: bold;
	}
	.st-dialog-content {
		font-size: 14px;
		margin-top: 12px;
		margin-bottom: 8px;
		line-height: 22px;
	}
	.st-dialog-actions {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}
	.st-dialog-btn {
		min-height: 44px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-left: 14px;
	}
	.st-dialog-cancel {
		font-size: 14px;
	}
	.st-dialog-ok {
		font-size: 14px;
		font-weight: bold;
	}
</style>
