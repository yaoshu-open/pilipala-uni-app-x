<template>
	<view class="bg" :style="pageStyle">
		<!-- 状态栏避让（口径同 pages/video：播放区从状态栏下方开始，底色跟页面） -->
		<view class="bg-statusbar" :style="statusBarStyle"></view>

		<view class="bg-stage">
			<player-stage
				:src="playSrc"
				:backup-src="playBackupSrc"
				:cover="cover"
				:title="title"
				:start-time="startSec"
				:auto-play="autoPlay"
				:duration-hint="durationHint"
				@back="onBack"
				@progress="onStageProgress"
				@playing="onStagePlaying"
				@fullscreen="onEnterFullscreen"
			></player-stage>
			<!-- 弹幕层：铺播放区「控制条以上」部分（口径同 pages/video，高度 = 播放区高 - 控制条 62px） -->
			<view class="bg-dm" :style="dmLayerStyle">
				<danmaku-layer
					:cid="cid"
					:playing="stagePlaying"
					:progress-ms="progressMs"
					:enabled="dmEnabled"
					:show-area="dmShowArea"
					:opacity="dmOpacity"
					:font-scale="dmFontScale"
					:duration-sec="dmDuration"
					:stroke-width="dmStrokeWidth"
					:block-types="dmBlockTypes"
				></danmaku-layer>
			</view>
		</view>

		<view class="bg-play-error" :style="playErrorStyle" @click="onRetryPlay">
			<text class="bg-play-error-text" :style="playErrorTextStyle">{{ playError }}</text>
			<text class="bg-play-error-retry" :style="primaryTextStyle">点击重试</text>
		</view>

		<view class="bg-loading" :style="loadingStyle">
			<view v-for="n in 4" :key="'sk-' + n.toString()" class="bg-sk-row">
				<skeleton-block width="100%" height="14px" radius="4px"></skeleton-block>
				<view class="bg-sk-gap"></view>
				<skeleton-block width="70%" height="12px" radius="4px"></skeleton-block>
			</view>
		</view>

		<view class="bg-fill" :style="errorViewStyle">
			<p-http-error :message="errorText" @retry="onRetryDetail"></p-http-error>
		</view>

		<view class="bg-main" :style="mainStyle">
			<!-- Tab 栏（1:1 视频详情基线：简介/评论 等分 + 发弹幕 + 弹幕开关） -->
			<view class="bg-tabs" :style="tabsStyle">
				<view class="bg-tabs-left" :style="tabsHalfStyle">
					<view class="bg-tab" @click="onTabIntro">
						<view class="bg-tab-inner" :style="tabUnderlineStyle('intro')">
							<text class="bg-tab-text" :style="tabTextStyle('intro')">简介</text>
						</view>
					</view>
					<view class="bg-tab" @click="onTabReply">
						<view class="bg-tab-inner" :style="tabUnderlineStyle('reply')">
							<text class="bg-tab-text" :style="tabTextStyle('reply')">评论 {{ replyCountText }}</text>
						</view>
					</view>
				</view>
				<view class="bg-tabs-right" :style="tabsHalfStyle">
					<view class="bg-dm-send" @click="openDanmakuSheet">
						<text class="bg-dm-send-text" :style="primaryTextStyle">发弹幕</text>
					</view>
					<view class="bg-dm-switch" @click="onToggleDanmaku">
						<p-icon name="chat-bubble-outline" :size="18" :color="dmEnabled ? primary : textSecondary()"></p-icon>
					</view>
				</view>
			</view>

			<view class="bg-content">
				<!-- 简介 Tab：信息面板 → 互动行 → 选集面板（1:1 番剧基线，无 UP 行/相关推荐） -->
				<scroll-view v-show="tab == 'intro'" class="bg-scroll" :scroll-top="scrollTop">
					<view class="bg-body" :style="bodyStyle">
						<!-- 信息面板：封面卡（评分角标）+ 右列（标题/追番钮/数据/放送/简介折叠） -->
						<view class="bg-info">
							<view class="bg-cover">
								<image class="bg-cover-img" :src="cover" mode="aspectFill"></image>
								<view class="bg-score" :style="scoreBadgeStyle">
									<text class="bg-score-text">{{ scoreText }}</text>
								</view>
							</view>
							<!-- 右列整块可点：展开简介详情弹层（源 InkWell 同款） -->
							<view class="bg-info-right" @click="openIntroSheet">
								<view class="bg-title-row">
									<text class="bg-title" :style="titleTextStyle" :max-lines="1">{{ title }}</text>
								<view class="bg-fav-btn" :style="favBtnStyle" @click.stop="onToggleFollowSeason">
									<p-icon :name="followed ? 'favorite' : 'favorite-border'" :size="22" :color="primary"></p-icon>
								</view>
								</view>
								<view class="bg-stat-row">
									<p-icon name="visibility" :size="12" :color="textSecondary()"></p-icon>
									<text class="bg-stat-text" :style="secondaryTextStyle">{{ statViewsText }}</text>
									<view class="bg-stat-gap"></view>
									<p-icon name="subtitles-outlined" :size="12" :color="textSecondary()"></p-icon>
									<text class="bg-stat-text" :style="secondaryTextStyle">{{ statDanmuText }}</text>
								</view>
								<text class="bg-meta" :style="secondaryTextStyle" :max-lines="1">{{ metaLineText }}</text>
								<text class="bg-meta" :style="secondaryTextStyle" :max-lines="1">{{ info != null ? info.newEpDesc : '' }}</text>
								<view class="bg-desc-flex"></view>
								<text class="bg-desc" :style="secondaryTextStyle" :max-lines="3">简介：{{ info != null ? info.evaluate : '' }}</text>
							</view>
						</view>

						<!-- 互动行（1:1 基线：赞/币/藏/评论/分享 五等分；oid=当前分集 bvid/aid，复用 api/play.uts） -->
						<view class="bg-actions">
							<view class="bg-act" @click="onLikeTap">
								<p-icon :name="liked ? 'thumb-up' : 'thumb-up-alt-outlined'" :size="20" :color="liked ? primary : textSecondary()"></p-icon>
								<text class="bg-act-text" :style="actTextStyle(liked)">{{ likeNum.toString() }}</text>
							</view>
							<view class="bg-act" @click="onCoinTap">
								<p-icon name="monetization-on-outlined" :size="20" :color="coined ? primary : textSecondary()"></p-icon>
								<text class="bg-act-text" :style="actTextStyle(coined)">{{ coinNum.toString() }}</text>
							</view>
							<view class="bg-act" @click="onFavTap">
								<p-icon :name="faved ? 'star' : 'star-outline'" :size="20" :color="faved ? primary : textSecondary()"></p-icon>
								<text class="bg-act-text" :style="actTextStyle(faved)">{{ favNum.toString() }}</text>
							</view>
							<view class="bg-act" @click="onTabReply">
								<p-icon name="chat-bubble-outline" :size="20" :color="textSecondary()"></p-icon>
								<text class="bg-act-text" :style="actTextStyle(false)">{{ replyNum.toString() }}</text>
							</view>
							<view class="bg-act" @click="onShareTap">
								<p-icon name="share-outlined" :size="20" :color="textSecondary()"></p-icon>
								<text class="bg-act-text" :style="actTextStyle(false)">{{ shareNum.toString() }}</text>
							</view>
						</view>

						<!-- 选集面板（episodes 非空才渲染）：状态行 + 横向选集（当前话主色高亮 + 会员标记） -->
						<view v-if="episodes.length > 0" class="bg-eps">
							<view class="bg-eps-head">
								<text class="bg-eps-title" :style="titleTextStyle">选集</text>
								<text class="bg-eps-playing" :style="secondaryTextStyle" :max-lines="1"> 正在播放：{{ playingLongTitle }}</text>
								<view class="bg-eps-status" @click="onToggleOrder">
									<text class="bg-eps-status-text" :style="primaryTextStyle" :max-lines="1">{{ info != null ? info.newEpDesc : '' }}</text>
								</view>
							</view>
							<!-- 横向滚动三要素（规约 §2.2）：容器 row + 确定宽 + 子项 flex-shrink:0 -->
							<scroll-view class="bg-eps-scroll" direction="horizontal" :show-scrollbar="false">
								<view class="bg-eps-row">
									<view
										v-for="(ep, i) in shownEpisodes"
										:key="'ep-' + ep.id.toString()"
										class="bg-ep"
										:style="epStyle(i)"
										@click="onSwitchEpisode(i)"
									>
										<view class="bg-ep-line1">
											<p-icon :name="isPlayingIndex(i) ? 'play-circle' : ''" :size="12" :color="primary"></p-icon>
											<text class="bg-ep-no" :style="epTextStyle(i)">{{ epIndexLabel(i) }}</text>
											<view class="bg-ep-flex"></view>
											<text class="bg-ep-badge" :style="primaryTextStyle">{{ ep.badge }}</text>
										</view>
										<text class="bg-ep-title" :style="epTextStyle(i)" :max-lines="1">{{ ep.longTitle.length > 0 ? ep.longTitle : ep.title }}</text>
									</view>
								</view>
							</scroll-view>
						</view>
					</view>
				</scroll-view>

				<view class="bg-reply-closed" :style="replyClosedStyle">
					<text class="bg-reply-closed-text" :style="secondaryTextStyle">该内容的评论区已关闭，暂时无法发表评论</text>
				</view>

				<!-- 评论 Tab：reply-list 完整复用（oid=分集 aid；watch oid 切集自动重拉） -->
				<view v-if="replyOpened" class="bg-reply-pane" :style="tab == 'reply' ? 'display:flex;' : 'display:none;'">
					<reply-list
						:oid="aid"
						:up-mid="''"
						:insert-seq="insertSeq"
						:insert-item="insertItem"
						:bottom-inset="replyBottomInset"
						@open-reply="onOpenReply"
						@reply="onReplyFromItem"
						@need-login="showLoginGuide"
						@seek="onSeekText"
						@open-user="onOpenUser"
						@open-link="onOpenLink"
						@req-code="onReqCode"
					></reply-list>
				</view>
			</view>
		</view>

		<!-- 发评论入口 -->
		<view class="bg-input-bar" :style="inputBarWrapStyle">
			<reply-input
				:oid="aid"
				:root="mainRoot"
				:parent="mainParent"
				:reply-to-name="replyTargetName"
				:force-close-seq="emoteCloseSeq"
				@sent="onSentComment"
				@need-login="showLoginGuide"
				@popup-state="onEmoteState"
				@cancel-reply="onCancelReplyTarget"
			></reply-input>
		</view>

		<!-- 发弹幕弹层（口径同 pages/video：键盘高度上移 + pushLocal 即时上屏） -->
		<view class="bg-dm-mask" :style="dmMaskStyle">
			<view class="bg-dm-mask-bg" @click="closeDanmakuSheet"></view>
			<view class="bg-dm-sheet" :style="dmSheetStyle">
				<view class="bg-dm-sheet-head">
					<text class="bg-dm-sheet-title" :style="titleTextStyle">发弹幕</text>
					<text class="bg-dm-sheet-tip" :style="secondaryTextStyle">{{ dmProgressText }}</text>
					<view class="bg-dm-sheet-close" @click="closeDanmakuSheet">
						<text class="bg-dm-sheet-close-text" :style="secondaryTextStyle">关闭</text>
					</view>
				</view>
				<view class="bg-dm-sheet-row">
					<input
						class="bg-dm-input"
						:style="dmInputStyle"
						:value="dmText"
						:maxlength="100"
						:adjust-position="false"
						placeholder="发个友善的弹幕见证当下"
						placeholder-class="bg-dm-placeholder"
						confirm-type="send"
						@input="onDmInput"
						@confirm="onSendDanmaku"
					/>
					<view class="bg-dm-submit" :style="dmSubmitStyle" @click="onSendDanmaku">
						<text class="bg-dm-submit-text">{{ dmSending ? '发送中' : '发送' }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 二级评论面板（楼中楼，口径同 pages/video） -->
		<view class="bg-sheet-mask" :style="sheetMaskStyle">
			<view class="bg-sheet" :style="sheetStyle">
				<view class="bg-sheet-head">
					<view class="bg-sheet-grip" @click="toggleSheetHeight">
						<view class="bg-sheet-grip-bar" :style="gripStyle"></view>
					</view>
					<view class="bg-sheet-title-row">
						<text class="bg-sheet-title" :style="titleTextStyle">评论详情</text>
						<text class="bg-sheet-tip" :style="secondaryTextStyle">{{ sheetHeightTip }}</text>
						<view class="bg-sheet-close" @click="closeSheet">
							<text class="bg-sheet-close-text" :style="secondaryTextStyle">关闭</text>
						</view>
					</view>
				</view>
				<scroll-view class="bg-sheet-scroll" :lower-threshold="200" @scrolltolower="onSheetLoadMore">
					<reply-item-view
						v-if="sheetRoot != null"
						:item="sheetRoot"
						level="2"
						:show-reply-row="false"
						@need-login="showLoginGuide"
						@reply="onReplyFromSheet"
						@seek="onSeekText"
						@open-user="onOpenUser"
						@open-link="onOpenLink"
					></reply-item-view>
					<view class="bg-sheet-sep" :style="sheetSepStyle"></view>
					<view v-if="sheetState == 'loading'" class="bg-sheet-state">
						<text class="bg-sheet-state-text" :style="secondaryTextStyle">加载中…</text>
					</view>
					<view v-else-if="sheetState == 'error'" class="bg-sheet-state" @click="reloadSheet">
						<text class="bg-sheet-state-text" :style="secondaryTextStyle">{{ sheetError }}</text>
						<text class="bg-sheet-state-retry" :style="primaryTextStyle">点击重试</text>
					</view>
					<view v-else-if="sheetList.length == 0" class="bg-sheet-state">
						<text class="bg-sheet-state-text" :style="secondaryTextStyle">还没有评论</text>
					</view>
					<view v-else class="bg-sheet-list">
						<reply-item-view
							v-for="reply in sheetList"
							:key="reply.rpid"
							:item="reply"
							level="2"
							:show-reply-row="false"
							@need-login="showLoginGuide"
							@reply="onReplyFromSheet"
							@seek="onSeekText"
							@open-user="onOpenUser"
							@open-link="onOpenLink"
						></reply-item-view>
					</view>
					<view class="bg-sheet-footer">
						<text class="bg-sheet-footer-text" :style="secondaryTextStyle">{{ sheetFooterText }}</text>
					</view>
				</scroll-view>
				<view class="bg-sheet-input">
					<reply-input
						:oid="aid"
						:root="sheetRootRpid"
						:parent="sheetParentRpid"
						:reply-to-name="sheetReplyName"
						placeholder="回复这条评论"
						:force-close-seq="emoteCloseSeq"
						@sent="onSheetSent"
						@need-login="showLoginGuide"
						@popup-state="onEmoteState"
						@cancel-reply="onCancelSheetReply"
					></reply-input>
				</view>
			</view>
		</view>

		<!-- 简介详情弹层（源 IntroDetail：标题/数据/放送/简介全文/声优） -->
		<view class="bg-intro-mask" :style="introMaskStyle">
			<view class="bg-intro-mask-bg" @click="closeIntroSheet"></view>
			<view class="bg-intro-sheet" :style="introSheetStyle">
				<view class="bg-intro-grip">
					<view class="bg-intro-grip-bar" :style="gripStyle"></view>
				</view>
				<scroll-view class="bg-intro-scroll" direction="vertical">
					<text class="bg-intro-title" :style="titleTextStyle">{{ title }}</text>
					<view class="bg-intro-stat-row">
						<text class="bg-intro-stat" :style="secondaryTextStyle">{{ statLineText }}</text>
					</view>
					<view class="bg-intro-meta-row">
						<text class="bg-intro-meta" :style="secondaryTextStyle">{{ introMetaText }}</text>
					</view>
					<text class="bg-intro-sec" :style="titleTextStyle">简介：</text>
					<text class="bg-intro-text" :style="secondaryTextStyle">{{ info != null ? info.evaluate : '' }}</text>
					<text v-if="actorsText.length > 0" class="bg-intro-sec" :style="titleTextStyle">声优</text>
					<text v-if="actorsText.length > 0" class="bg-intro-text" :style="secondaryTextStyle">{{ actorsText }}</text>
					<view class="bg-intro-bottom" :style="introBottomStyle"></view>
				</scroll-view>
			</view>
		</view>

		<!-- 投币弹层（源 AlertDialog 1/2 枚单选） -->
		<view class="bg-coin-mask" :style="coinMaskStyle">
			<view class="bg-coin-mask-bg" @click="closeCoinSheet"></view>
			<view class="bg-coin-dialog" :style="coinDialogStyle">
				<text class="bg-coin-title" :style="titleTextStyle">选择投币个数</text>
				<view class="bg-coin-opt" @click="onCoinChoose(1)">
					<text class="bg-coin-opt-text" :style="titleTextStyle">1 枚</text>
				</view>
				<view class="bg-coin-opt" @click="onCoinChoose(2)">
					<text class="bg-coin-opt-text" :style="titleTextStyle">2 枚</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onLoad, onShow, onHide, onUnload, onBackPress } from '@dcloudio/uni-app'
import PlayerStage from '../../components/player/player-stage.uvue'
import DanmakuLayer from '../../components/player/danmaku-layer.uvue'
import PIcon from '../../components/p-icon/p-icon.uvue'
import ReplyList from '../../components/reply/reply-list.uvue'
import ReplyInput from '../../components/reply/reply-input.uvue'
import ReplyItemView from '../../components/reply/reply-item.uvue'
import PHttpError from '../../components/p-http-error/p-http-error.uvue'
import SkeletonBlock from '../../components/skeleton/skeleton-block.uvue'
import { fetchBangumiInfo, bangumiFollowAdd, bangumiFollowDel } from '../../api/bangumi.uts'
import { fetchPlayUrl, hasLike, hasCoin, hasFav, likeVideo, coinVideo, toggleDefaultFav } from '../../api/play.uts'
import { fetchReplyReplyList, REPLY_CLOSED_CODE } from '../../api/reply.uts'
import { sendDanmaku } from '../../api/danmaku.uts'
import { useDanmaku } from '../../composables/useDanmaku.uts'
import { BangumiInfo, BangumiEpisode } from '../../models/bangumi.uts'
import { ReplyItem } from '../../models/reply.uts'
import { userState } from '../../stores/user.uts'
import { ensureLoginState } from '../../composables/useLogin.uts'
import {
	pageBackground, cardBackground, textPrimary, textSecondary, themeColor, currentThemeIndex,
	withAlpha, errorText as themeErrorText, errorBackground
} from '../../utils/theme.uts'
import { numFormat, timeFormat } from '../../utils/format.uts'
import { toSecureUrl } from '../../utils/url.uts'
import {
	getBool, setBool, SK,
	getDanmakuBlockType, getDanmakuShowArea, getDanmakuOpacity, getDanmakuFontScale,
	getDanmakuDuration, getDanmakuStrokeWidth
} from '../../utils/storage.uts'
import { safeAreaBottom, statusBarHeight } from '../../utils/safeArea.uts'

/**
 * 番剧详情页（源头：`lib/pages/bangumi/introduction/*`——与视频详情共享 VideoDetailController）。
 * 复用边界（设计_设置与杂项域 §七，P11 拍板）：**复用** player-stage（durl 播放）、danmaku-layer（分集 cid 弹幕）、
 * api/play.uts 全部互动函数（赞/币/藏：oid=当前分集 bvid/aid，源 controller 同口径）/ 评论组件 reply-list +
 * reply-input（oid=分集 aid number + type=1 视频口径，与番剧评论同源）、全屏页跳转链。
 * **新增**（本页内）：番剧信息面板（封面评分角标+追番钮）/ 选集横排 / 简介弹层 / 投币弹层。
 * 取流：番剧分集走同一 /x/player/wbi/playurl（bvid+cid，源 changeSeasonOrbangu 同函数），不另建取流接口。
 * 切分集 = 换 bvid/cid/aid 重取流 + 三态重拉 + 评论组件 watch oid 自动重拉（seek 0 起播）。
 * 追番：/pgc/web/follow/add|del（seasonId 口径，csrf 前置真实失败态，toast 用 result.toast）。
 * 会员分集：badge=='会员' 且非大会员 → toast 拦截（源 BangumiPanel.changeFucCall 同款）。
 * 参数：season_id / ep_id 二选一（源 SearchHttp.bangumiInfo 同款）。
 */

const seasonId = ref<number>(0)
const epId = ref<number>(0)
const bvid = ref<string>('')
const cid = ref<number>(0)
const aidNo = ref<number>(0)
const detail = ref<BangumiInfo | null>(null)
const state = ref<string>('loading')
const errorText = ref<string>('')
const playSrc = ref<string>('')
const playBackupSrc = ref<string>('')
const startSec = ref<number>(0)
const durationHint = ref<number>(0)
const playError = ref<string>('')
const autoPlay = ref<boolean>(true)
/** 选集正/倒序（源 BangumiPanel 未提供、EpisodeBottomSheet 提供；本页状态行点击切换） */
const epDesc = ref<boolean>(false)

// 互动三态（oid=分集 bvid/aid）
const liked = ref<boolean>(false)
const coined = ref<boolean>(false)
const faved = ref<boolean>(false)
const likeNum = ref<number>(0)
const coinNum = ref<number>(0)
const favNum = ref<number>(0)
const replyNum = ref<number>(0)
const shareNum = ref<number>(0)
const busy = ref<boolean>(false)
const followed = ref<boolean>(false)
const followBusy = ref<boolean>(false)
const coinVisible = ref<boolean>(false)

// Tab 与评论
const tab = ref<string>('intro')
const scrollTop = ref<number>(0)
const insertSeq = ref<number>(0)
const insertItem = ref<ReplyItem | null>(null)
const extraReplyCount = ref<number>(0)
const replyClosed = ref<boolean>(false)
const replyOpened = ref<boolean>(false)
const emoteOpen = ref<boolean>(false)
const emoteCloseSeq = ref<number>(0)
const mainRoot = ref<string>('')
const mainParent = ref<string>('')
const replyTargetName = ref<string>('')

// 二级评论面板
const sheetVisible = ref<boolean>(false)
const sheetExpanded = ref<boolean>(false)
const sheetRoot = ref<ReplyItem | null>(null)
const sheetList = ref<Array<ReplyItem>>([])
const sheetState = ref<string>('loading')
const sheetError = ref<string>('')
const sheetPage = ref<number>(0)
const sheetNoMore = ref<boolean>(false)
const sheetLoading = ref<boolean>(false)
const sheetReplyTarget = ref<ReplyItem | null>(null)
const sheetReplyName = ref<string>('')
let lastSheetLoadAt: number = 0

// 发弹幕
const dmSheetVisible = ref<boolean>(false)
const dmText = ref<string>('')
