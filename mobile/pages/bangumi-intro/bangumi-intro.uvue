const sheetMaskStyle = computed((): string => sheetVisible.value ? 'display:flex;' : 'display:none;')
const introMaskStyle = computed((): string => introVisible.value ? 'display:flex;' : 'display:none;')
const coinMaskStyle = computed((): string => coinVisible.value ? 'display:flex;' : 'display:none;')
const replyPaneStyle = computed((): string => replyOpened.value && tab.value == 'reply' ? 'display:flex;' : 'display:none;')
const replyClosedStyle = computed((): string => tab.value == 'reply' && replyClosed.value ? 'display:flex;' : 'display:none;')
const inputBarWrapStyle = computed((): string => {
	const show = state.value == 'ready' && tab.value == 'reply' && !replyClosed.value
	return show ? 'display:flex;' : 'display:none;'
})
const tabsHalfStyle = computed((): string => 'width:' + Math.round((winWidth.value > 0 ? winWidth.value : 390) / 2).toString() + 'px;')
const tabsStyle = computed((): string => 'background-color:' + cardBackground() + ';border-bottom-color:' + withAlpha(textSecondary(), 0.2) + ';')
const primaryTextStyle = computed((): string => 'color:' + primary + ';')
const secondaryTextStyle = computed((): string => 'color:' + textSecondary() + ';')
const titleTextStyle = computed((): string => 'color:' + textPrimary() + ';')
const gripStyle = computed((): string => 'background-color:' + textSecondary() + ';')
const sheetSepStyle = computed((): string => 'background-color:' + pageBackground() + ';')
const bodyStyle = computed((): string => 'padding-bottom:' + (safeAreaBottom() + 8).toString() + 'px;')
const scoreBadgeStyle = computed((): string => 'background-color:' + withAlpha(primary, 0.9) + ';')
const favBtnStyle = computed((): string => 'background-color:' + withAlpha(primary, 0.12) + ';')
const favIconStyle = computed((): string => 'color:' + primary + ';')
const epBadgeBgStyle = computed((): string => 'background-color:' + pageBackground() + ';')
const inputBarHeight = computed((): number => 60 + safeAreaBottom())
const replyBottomInset = computed((): number => replyClosed.value ? 0 : inputBarHeight.value)

const stageHeight = computed((): number => {
	const width = winWidth.value > 0 ? winWidth.value : 390
	return Math.round(width * 9 / 16)
})
const dmLayerStyle = computed((): string => {
	const height = stageHeight.value - CONTROL_BAR_HEIGHT
	return 'height:' + (height > 0 ? height : 0).toString() + 'px;'
})

const info = computed((): BangumiInfo | null => detail.value)
const title = computed((): string => {
	const d = detail.value
	return d == null ? '' : d.title
})
const cover = computed((): string => {
	const d = detail.value
	return d == null ? '' : toSecureUrl(d.cover)
})
const aid = computed((): number => aidNo.value)
const episodes = computed((): Array<BangumiEpisode> => {
	const d = detail.value
	return d == null ? [] as Array<BangumiEpisode> : d.episodes
})
/** 选集展示序（倒序只反转展示，索引换算回正序） */
const shownEpisodes = computed((): Array<BangumiEpisode> => {
	const list = episodes.value
	if (!epDesc.value) {
		return list
	}
	const reversed: Array<BangumiEpisode> = []
	for (let i = list.length - 1; i >= 0; i--) {
		reversed.push(list[i])
	}
	return reversed
})
const playingIndex = computed((): number => {
	const list = episodes.value
	for (let i = 0; i < list.length; i++) {
		if (list[i].cid == cid.value) {
			return i
		}
	}
	return -1
})
const playingLongTitle = computed((): string => {
	const idx = playingIndex.value
	if (idx < 0) {
		return ''
	}
	const ep = episodes.value[idx]
	return ep.longTitle.length > 0 ? ep.longTitle : ep.title
})
const scoreText = computed((): string => {
	const d = detail.value
	if (d == null || d.ratingScore <= 0) {
		return '暂无'
	}
	return '评分 ' + d.ratingScore.toString()
})
const statLineText = computed((): string => {
	const d = detail.value
	if (d == null) {
		return ''
	}
	return numFormat(d.stat.views) + '  ' + numFormat(d.stat.danmakus)
})
const statViewsText = computed((): string => {
	const d = detail.value
	return d == null ? '' : numFormat(d.stat.views)
})
const statDanmuText = computed((): string => {
	const d = detail.value
	return d == null ? '' : numFormat(d.stat.danmakus)
})
const metaLineText = computed((): string => {
	const d = detail.value
	if (d == null) {
		return ''
	}
	let text = d.areaName
	if (d.pubTimeShow.length > 0) {
		text = text.length > 0 ? text + ' · ' + d.pubTimeShow : d.pubTimeShow
	}
	return text
})
const introMetaText = computed((): string => {
	const d = detail.value
	if (d == null) {
		return ''
	}
	let text = metaLineText.value
	if (d.newEpDesc.length > 0) {
		text = text.length > 0 ? text + ' · ' + d.newEpDesc : d.newEpDesc
	}
	return text
})
const actorsText = computed((): string => {
	const d = detail.value
	return d == null ? '' : d.actors
})
const replyCountText = computed((): string => {
	const d = detail.value
	if (d == null) {
		return ''
	}
	return numFormat(d.stat.reply + extraReplyCount.value)
})
const dmSwitchStyle = computed((): string => 'color:' + (dmEnabled.value ? primary : textSecondary()) + ';')
	const dmProgressText = computed((): string => '发送位置 ' + timeFormat(Math.floor(progressMs.value / 1000)))
const dmInputStyle = computed((): string => 'background-color:' + pageBackground() + ';color:' + textPrimary() + ';')
const dmSubmitEnabled = computed((): boolean => dmText.value.trim().length > 0 && !dmSending.value)
const dmSubmitStyle = computed((): string => 'background-color:' + (dmSubmitEnabled.value ? primary : withAlpha(textSecondary(), 0.3)) + ';')
const dmSheetStyle = computed((): string => {
	const bottomPad = kbHeight.value > 0 ? 10 : safeAreaBottom() + 10
	const lift = kbHeight.value > 0 ? 'margin-bottom:' + kbHeight.value.toString() + 'px;' : ''
	return lift + 'padding-bottom:' + bottomPad.toString() + 'px;background-color:' + cardBackground() + ';'
})
const sheetStyle = computed((): string => {
	const base = winHeight.value > 0 ? winHeight.value : 640
	const height = sheetExpanded.value ? base * 0.88 : base * 0.62
	return 'height:' + Math.round(height).toString() + 'px;background-color:' + cardBackground() + ';'
})
const sheetHeightTip = computed((): string => sheetExpanded.value ? '点击把手收起' : '点击把手展开')
const introSheetStyle = computed((): string => {
	const base = winHeight.value > 0 ? winHeight.value : 640
	return 'height:' + Math.round(base * 0.6).toString() + 'px;background-color:' + cardBackground() + ';'
})
const introBottomStyle = computed((): string => 'height:' + (safeAreaBottom() + 20).toString() + 'px;')
const coinDialogStyle = computed((): string => 'background-color:' + cardBackground() + ';')
const sheetRootRpid = computed((): string => {
	const root = sheetRoot.value
	return root == null ? '' : root.rpid
})
const sheetParentRpid = computed((): string => {
	const target = sheetReplyTarget.value
	if (target != null) {
		return target.rpid
	}
	return sheetRootRpid.value
})
const sheetFooterText = computed((): string => {
	if (sheetState.value != 'ready' || sheetList.value.length == 0) {
		return ''
	}
	if (sheetNoMore.value) {
		return '没有更多了'
	}
	return sheetLoading.value ? '加载中…' : '上拉加载更多'
})

function tabTextStyle(name: string): string {
	return 'color:' + (tab.value == name ? primary : textSecondary()) + ';'
}

function tabUnderlineStyle(name: string): string {
	return 'border-bottom-color:' + (tab.value == name ? primary : 'rgba(0,0,0,0)') + ';'
}

function actIconStyle(on: boolean): string {
	return 'color:' + (on ? primary : textSecondary()) + ';'
}

function actTextStyle(on: boolean): string {
	return 'color:' + (on ? primary : textSecondary()) + ';'
}

function epStyle(shownIndex: number): string {
	return 'background-color:' + (isPlayingIndex(shownIndex) ? withAlpha(primary, 0.1) : pageBackground()) + ';'
}

function epTextStyle(shownIndex: number): string {
	return 'color:' + (isPlayingIndex(shownIndex) ? primary : textPrimary()) + ';'
}

/** 展示索引（含倒序）是否是当前播放集 */
function isPlayingIndex(shownIndex: number): boolean {
	const target = shownEpisodes.value[shownIndex]
	if (target == null) {
		return false
	}
	return target.cid == cid.value
}

/** 分集序号：源 BangumiPanel 用**正序列表下标**（第${i+1}话），倒序展示只改显示顺序、序号仍按正序 */
function epIndexLabel(shownIndex: number): string {
	const target = shownEpisodes.value[shownIndex]
	if (target == null) {
		return ''
	}
	const list = episodes.value
	for (let i = 0; i < list.length; i++) {
		if (list[i].cid == target.cid) {
			return '第' + (i + 1).toString() + '话'
		}
	}
	return ''
}

function scrollToTop() {
	scrollTop.value = 1
	setTimeout(() => {
		scrollTop.value = 0
	}, 16)
}

// ---------------------------------------------------------------- 数据加载

async function loadAll() {
	state.value = 'loading'
	errorText.value = ''
	playSrc.value = ''
	playError.value = ''
	// 冷启动登录态自愈（P8 deliverable）：追番态/三态依赖登录，不能按内存标志预判
	await ensureLoginState()
	const res = await fetchBangumiInfo(seasonId.value, epId.value)
	if (!res.status || res.data == null) {
		state.value = 'error'
		errorText.value = res.message.length > 0 ? res.message : '请求异常'
		return
	}
	const d = res.data
	detail.value = d
	followed.value = d.followed == 1
	likeNum.value = d.stat.likes
	coinNum.value = d.stat.coins
	favNum.value = d.stat.favorite
	replyNum.value = d.stat.reply
	shareNum.value = d.stat.share
	// 默认集：epId 对应集优先，否则第一集（源 controller.queryBangumiIntro 同款）
	const list = d.episodes
	let current: BangumiEpisode | null = null
	if (epId.value > 0) {
		for (let i = 0; i < list.length; i++) {
			if (list[i].id == epId.value) {
				current = list[i]
				break
			}
		}
	}
	if (current == null && list.length > 0) {
		current = list[0]
	}
	if (current == null || current.cid <= 0 || current.bvid.length == 0) {
		state.value = 'ready'
		playError.value = '该剧暂无可播放分集'
		return
	}
	bvid.value = current.bvid
	cid.value = current.cid
	aidNo.value = current.aid
	state.value = 'ready'
	await loadPlay()
	await loadActions()
}

async function loadPlay() {
	playError.value = ''
	playSrc.value = ''
	playBackupSrc.value = ''
	if (bvid.value.length == 0 || cid.value <= 0) {
		playError.value = '缺少播放参数，暂时无法起播'
		return
	}
	// 番剧分集与视频同一取流端点（源 changeSeasonOrbangu → VideoDetailController.queryVideoUrl）
	const res = await fetchPlayUrl(bvid.value, cid.value, false)
	if (!res.status || res.data == null) {
		playError.value = res.message.length > 0 ? res.message : '播放地址获取失败'
		return
	}
	const data = res.data
	if (data.durl.length == 0 || data.durl[0].url.length == 0) {
		playError.value = '该分集暂无可播放地址（可能需要大会员或登录）'
		return
	}
	startSec.value = data.lastPlayTime > 0 ? Math.floor(data.lastPlayTime / 1000) : 0
	durationHint.value = data.timeLength > 0 ? Math.floor(data.timeLength / 1000) : 0
	playSrc.value = data.durl[0].url
	playBackupSrc.value = data.durl[0].backupUrl
}

/** 三态重拉（登录态；切分集后调用） */
async function loadActions() {
	if (!userState.isLogin || bvid.value.length == 0) {
		liked.value = false
		coined.value = false
		faved.value = false
		return
	}
	const likeRes = await hasLike(bvid.value)
	if (likeRes.status) {
		liked.value = likeRes.value
	}
	const coinRes = await hasCoin(bvid.value)
	if (coinRes.status) {
		coined.value = coinRes.multiply > 0
	}
	const favRes = await hasFav(aidNo.value)
	if (favRes.status) {
		faved.value = favRes.value
	}
}

function onRetryDetail() {
	loadAll()
}

function onRetryPlay() {
	loadPlay()
}

// ---------------------------------------------------------------- 切分集
async function onSwitchEpisode(shownIndex: number) {
	const ep = shownEpisodes.value[shownIndex]
	if (ep == null || ep.cid <= 0 || ep.bvid.length == 0) {
		return
	}
	// 会员分集拦截（源 BangumiPanel.changeFucCall 同款：badge=='会员' 且非大会员）
	if (ep.badge == '会员' && userState.info.vipStatus != 1) {
		uni.showToast({ title: '需要大会员', icon: 'none' })
		return
	}
	if (ep.cid == cid.value) {
		return
	}
	bvid.value = ep.bvid
	cid.value = ep.cid
	aidNo.value = ep.aid
	epId.value = ep.id
	scrollToTop()
	await loadPlay()
	await loadActions()
}

function onToggleOrder() {
	epDesc.value = !epDesc.value
}

// ---------------------------------------------------------------- 互动（oid=分集 bvid/aid，复用 api/play.uts）
function showLoginGuide() {
	uni.showModal({
		title: '未登录',
		content: '该操作需要登录，是否前往登录？',
		confirmText: '去登录',
		cancelText: '取消',
		success: (res) => {
			if (res.confirm == true) {
				uni.navigateTo({ url: '/pages/login/login' })
			}
		}
	})
}

async function onLikeTap() {
	if (!userState.isLogin) {
		showLoginGuide()
		return
	}
	if (busy.value || bvid.value.length == 0) {
		return
	}
	busy.value = true
	const res = await likeVideo(bvid.value, !liked.value)
	busy.value = false
	if (!res.status) {
		uni.showToast({ title: res.message, icon: 'none' })
		return
	}
	liked.value = !liked.value
	likeNum.value = likeNum.value + (liked.value ? 1 : -1)
}

function onCoinTap() {
	if (!userState.isLogin) {
		showLoginGuide()
		return
	}
	if (coined.value) {
		uni.showToast({ title: '已经投过币了', icon: 'none' })
		return
	}
	coinVisible.value = true
}

function closeCoinSheet() {
	coinVisible.value = false
}

async function onCoinChoose(multiply: number) {
	if (busy.value || bvid.value.length == 0) {
		return
	}
	busy.value = true
	const res = await coinVideo(bvid.value, multiply)
	busy.value = false
	coinVisible.value = false
	if (!res.status) {
		uni.showToast({ title: res.message, icon: 'none' })
		return
	}
	coined.value = true
	coinNum.value = coinNum.value + multiply
	uni.showToast({ title: '投币成功', icon: 'none' })
}

async function onFavTap() {
	if (!userState.isLogin) {
		showLoginGuide()
		return
	}
	if (busy.value || aidNo.value <= 0) {
		return
	}
	busy.value = true
	const res = await toggleDefaultFav(aidNo.value)
	busy.value = false
	if (!res.status) {
		uni.showToast({ title: res.message, icon: 'none' })
		return
	}
	faved.value = res.faved
	favNum.value = favNum.value + (faved.value ? 1 : -1)
}

function onShareTap() {
	uni.setClipboardData({
		data: 'https://www.bilibili.com/bangumi/play/ss' + seasonId.value.toString(),
		success: (_) => {
			uni.showToast({ title: '链接已复制，可粘贴分享', icon: 'none' })
		}
	})
}

/** 追番/取消追番（seasonId 口径；toast 用接口 result.toast，失败原样呈现） */
async function onToggleFollowSeason() {
	const d = detail.value
	if (d == null || d.seasonId <= 0) {
		return
	}
	if (!userState.isLogin) {
		showLoginGuide()
		return
	}
	if (followBusy.value) {
		return
	}
	followBusy.value = true
	const res = followed.value ? await bangumiFollowDel(d.seasonId) : await bangumiFollowAdd(d.seasonId)
	followBusy.value = false
	if (!res.status) {
		uni.showToast({ title: res.message.length > 0 ? res.message : '操作失败', icon: 'none' })
		return
	}
	followed.value = !followed.value
	uni.showToast({ title: res.toast, icon: 'none' })
}

// ---------------------------------------------------------------- Tab 与评论事件
function onTabIntro() {
	tab.value = 'intro'
}

function onTabReply() {
	replyOpened.value = true
	tab.value = 'reply'
}

function onReqCode(code: number) {
	replyClosed.value = code == REPLY_CLOSED_CODE
}

function onEmoteState(open: boolean) {
	emoteOpen.value = open
}

function onSeekText(text: string, _seconds: number) {
	uni.showToast({ title: '跳到 ' + text + '：播放进度跳转随全屏控制层接入', icon: 'none' })
}

function onOpenUser(mid: string) {
	if (mid.length == 0) {
		return
	}
	uni.navigateTo({ url: '/pages/member/member?mid=' + mid })
}

function onOpenLink(text: string) {
	if (text.length == 0) {
		return
	}
	uni.navigateTo({
		url: '/pages/webview/webview?type=webview&url=' + encodeURIComponent(text)
	})
}

function onOpenReply(root: ReplyItem) {
	sheetRoot.value = root
	sheetList.value = []
	sheetReplyTarget.value = null
	sheetReplyName.value = ''
	sheetError.value = ''
	sheetState.value = 'loading'
	sheetPage.value = 0
	sheetNoMore.value = false
	sheetExpanded.value = false
	sheetVisible.value = true
	loadSheetPage(1)
}

function closeSheet() {
	sheetVisible.value = false
	sheetRoot.value = null
	sheetList.value = []
	sheetReplyTarget.value = null
	sheetReplyName.value = ''
}

function toggleSheetHeight() {
	sheetExpanded.value = !sheetExpanded.value
}

async function loadSheetPage(pn: number) {
	if (sheetLoading.value) {
		return
	}
	const root = sheetRoot.value
	if (root == null || aidNo.value <= 0) {
		return
	}
	sheetLoading.value = true
	if (pn == 1) {
		sheetState.value = 'loading'
		sheetError.value = ''
	}
	const res = await fetchReplyReplyList(aidNo.value, root.rpid, pn)
	sheetLoading.value = false
	if (!res.status || res.data == null) {
		if (pn == 1) {
			sheetState.value = 'error'
			sheetError.value = res.message.length > 0 ? res.message : '请求异常'
		} else {
			uni.showToast({ title: res.message.length > 0 ? res.message : '请求异常', icon: 'none' })
		}
		return
	}
	const data = res.data
	const next: Array<ReplyItem> = pn == 1 ? [] : sheetList.value.slice()
	for (let i = 0; i < data.replies.length; i++) {
		next.push(data.replies[i])
	}
	sheetList.value = next
	sheetPage.value = pn
	sheetNoMore.value = data.replies.length < 18
	sheetState.value = 'ready'
}

function onSheetLoadMore() {
	if (sheetState.value != 'ready' || sheetNoMore.value || sheetLoading.value) {
		return
	}
	const now = Date.now()
	if (now - lastSheetLoadAt < 200) {
		return
	}
	lastSheetLoadAt = now
	loadSheetPage(sheetPage.value + 1)
}

function reloadSheet() {
	loadSheetPage(1)
}

function onReplyFromSheet(item: ReplyItem) {
	sheetReplyTarget.value = item
	sheetReplyName.value = item.member.uname
}

function onCancelSheetReply() {
	sheetReplyTarget.value = null
	sheetReplyName.value = ''
}

function onSheetSent(item: ReplyItem) {
	const next: Array<ReplyItem> = [item]
	for (let i = 0; i < sheetList.value.length; i++) {
		next.push(sheetList.value[i])
	}
	sheetList.value = next
	sheetState.value = 'ready'
	const root = sheetRoot.value
	if (root != null) {
		root.count = root.count + 1
		root.replies.push(item)
	}
	sheetReplyTarget.value = null
	sheetReplyName.value = ''
}

function onReplyFromItem(item: ReplyItem) {
	mainRoot.value = item.root == '0' ? item.rpid : item.root
	mainParent.value = item.rpid
	replyTargetName.value = item.member.uname
}

function onCancelReplyTarget() {
	mainRoot.value = ''
	mainParent.value = ''
	replyTargetName.value = ''
}

function onSentComment(item: ReplyItem) {
	insertItem.value = item
	insertSeq.value = insertSeq.value + 1
	extraReplyCount.value = extraReplyCount.value + 1
	onCancelReplyTarget()
}

// ---------------------------------------------------------------- 弹幕与全屏（口径同 pages/video）
function loadDanmakuConfig() {
	dmEnabled.value = getBool(SK.enableShowDanmaku, false)
	dmShowArea.value = getDanmakuShowArea()
	dmOpacity.value = getDanmakuOpacity()
	dmFontScale.value = getDanmakuFontScale()
	dmDuration.value = getDanmakuDuration()
	dmStrokeWidth.value = getDanmakuStrokeWidth()
	dmBlockTypes.value = getDanmakuBlockType()
}

function onStageProgress(ms: number) {
	progressMs.value = ms
}

function onStagePlaying(playing: boolean) {
	stagePlaying.value = playing
}

function onToggleDanmaku() {
	dmEnabled.value = !dmEnabled.value
	setBool(SK.enableShowDanmaku, dmEnabled.value)
	uni.showToast({ title: dmEnabled.value ? '弹幕已开启' : '弹幕已关闭', icon: 'none' })
}

function openDanmakuSheet() {
	if (state.value != 'ready') {
		return
	}
	dmText.value = ''
	dmSheetVisible.value = true
}

function closeDanmakuSheet() {
	dmSheetVisible.value = false
	kbHeight.value = 0
	uni.hideKeyboard()
}

function onDmInput(event: UniInputEvent) {
	dmText.value = event.detail.value
}

async function onSendDanmaku() {
	const text = dmText.value.trim()
	if (text.length == 0) {
		uni.showToast({ title: '弹幕内容不能为空', icon: 'none' })
		return
	}
	if (dmSending.value) {
		return
	}
	if (cid.value <= 0 || bvid.value.length == 0) {
		uni.showToast({ title: '分集信息未就绪，请稍后重试', icon: 'none' })
		return
	}
	dmSending.value = true
	const res = await sendDanmaku(cid.value, bvid.value, text, progressMs.value, 1, 16777215, 25, 0)
	dmSending.value = false
	if (!res.status) {
		uni.showToast({ title: res.message, icon: 'none' })
		return
	}
	const item = res.item
	if (item != null) {
		useDanmaku().pushLocal(cid.value, item)
	}
	closeDanmakuSheet()
	uni.showToast({ title: dmEnabled.value ? '弹幕已发送' : '弹幕已发送（弹幕开关已关，开启后可见）', icon: 'none' })
}

function q(value: string): string {
	return encodeURIComponent(value)
}

let fullscreenSrc = ''
let fullscreenEnterSec = 0

function releaseStageForFullscreen(sec: number) {
	fullscreenSrc = playSrc.value
	fullscreenEnterSec = sec
	try {
		const ctx = uni.createVideoContext('vd-video')
		if (ctx != null) {
			ctx.pause()
		}
	} catch (e) {
		console.log('[bangumi] pause before fullscreen failed')
	}
	playSrc.value = ''
	stagePlaying.value = false
}

function restoreStageAfterFullscreen(sec: number) {
	if (fullscreenSrc.length == 0) {
		return
	}
	const url = fullscreenSrc
	fullscreenSrc = ''
	if (playSrc.value.length == 0) {
		startSec.value = sec
		playSrc.value = url
		return
	}
	try {
		const ctx = uni.createVideoContext('vd-video')
		if (ctx != null) {
			ctx.seek(sec)
			ctx.play()
		}
	} catch (e) {
		console.log('[bangumi] resume after fullscreen failed')
	}
}

function onEnterFullscreen() {
	if (playSrc.value.length == 0) {
		uni.showToast({ title: '播放地址未就绪，暂不能全屏', icon: 'none' })
		return
	}
	const startSecOut = progressMs.value > 0 ? Math.floor(progressMs.value / 1000) : 0
	let url = '/pages/video/fullscreen?bvid=' + bvid.value +
		'&cid=' + cid.value.toString() +
		'&src=' + q(playSrc.value) +
		'&startTime=' + startSecOut.toString() +
		'&danmakuCid=' + cid.value.toString()
	if (cover.value.length > 0) {
		url = url + '&cover=' + q(cover.value)
	}
	if (title.value.length > 0) {
		url = url + '&title=' + q(title.value)
	}
	fullscreenLaunched = true
	releaseStageForFullscreen(startSecOut)
	uni.navigateTo({
		url: url,
		fail: (err) => {
			console.log('[bangumi] enter fullscreen failed: ' + err.errMsg)
			fullscreenLaunched = false
			restoreStageAfterFullscreen(startSecOut)
		}
	})
}

function onFullscreenExit(payload: any) {
	if (!fullscreenLaunched) {
		return
	}
	if (payload == null) {
		return
	}
	const obj = payload as UTSJSONObject
	const value = obj.getNumber('position')
	if (value == null) {
		return
	}
	const position = value as number
	if (position < 0) {
		return
	}
	pendingResumeSec.value = position
}

// ---------------------------------------------------------------- 简介弹层
function openIntroSheet() {
	introVisible.value = true
}

function closeIntroSheet() {
	introVisible.value = false
}

function onBack() {
	const stack = getCurrentPages()
	if (stack.length > 1) {
		uni.navigateBack({ delta: 1 })
	} else {
		uni.reLaunch({ url: '/pages/main/main' })
	}
}

// 浮层返回接管：发弹幕 → 二级面板 → 简介 → 投币 → 表情 依次收（页面级钩子，写在组件内无效）
onBackPress(() => {
	if (dmSheetVisible.value) {
		closeDanmakuSheet()
		return true
	}
	if (sheetVisible.value) {
		closeSheet()
		return true
	}
	if (introVisible.value) {
		closeIntroSheet()
		return true
	}
	if (coinVisible.value) {
		closeCoinSheet()
		return true
	}
	if (emoteOpen.value) {
		emoteCloseSeq.value = emoteCloseSeq.value + 1
		emoteOpen.value = false
		return true
	}
	return false
})

onLoad((options) => {
	const rawSeason = options != null ? options['season_id'] : null
	if (rawSeason != null) {
		const parsed = parseInt(rawSeason as string)
		seasonId.value = isNaN(parsed) ? 0 : parsed
	}
	const rawEp = options != null ? options['ep_id'] : null
	if (rawEp != null) {
		const parsedEp = parseInt(rawEp as string)
		epId.value = isNaN(parsedEp) ? 0 : parsedEp
	}
	if (seasonId.value <= 0 && epId.value <= 0) {
		state.value = 'error'
		errorText.value = '缺少番剧参数（season_id / ep_id），请从番剧入口进入'
		return
	}
	autoPlay.value = getBool(SK.autoPlayEnable, true)
	loadDanmakuConfig()
	try {
		kbListenerId = uni.onKeyboardHeightChange((res) => {
			kbHeight.value = res.height
		})
	} catch (e) {
		kbHeight.value = 0
		console.log('[bangumi] keyboard height listener unavailable')
	}
	uni.$on('player:fullscreen-exit', onFullscreenExit)
	loadAll()
})

onShow(() => {
	loadDanmakuConfig()
	if (pendingResumeSec.value >= 0) {
		const sec = pendingResumeSec.value
		pendingResumeSec.value = -1
		fullscreenLaunched = false
		restoreStageAfterFullscreen(sec)
	} else if (fullscreenSrc.length > 0 && playSrc.value.length == 0) {
		restoreStageAfterFullscreen(fullscreenEnterSec)
	}
})

onHide(() => {
	try {
		const ctx = uni.createVideoContext('vd-video')
		if (ctx != null) {
			ctx.pause()
		}
	} catch (e) {
		console.log('[bangumi] pause on hide failed')
	}
})

onUnload(() => {
	uni.$off('player:fullscreen-exit', onFullscreenExit)
	if (kbListenerId >= 0) {
		uni.offKeyboardHeightChange(kbListenerId)
		kbListenerId = -1
	}
})
</script>

