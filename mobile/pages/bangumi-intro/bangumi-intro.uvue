const primary = themeColor(currentThemeIndex())
const pageStyle = computed((): string => 'background-color:' + pageBackground() + ';')
const statusBarStyle = computed((): string => 'height:' + statusBarHeight().toString() + 'px;background-color:' + pageBackground() + ';')
const playErrorStyle = computed((): string => {
	const show = playError.value.length > 0 ? 'display:flex;' : 'display:none;'
