<template>
	<view class="mi" :style="pageStyle">
		<!-- 顶栏：左标题 PLPL（源 mine/view.dart:47 AppBar title，Jura-Bold 17）+ 右月亮 + 齿轮（月亮=主题切换，齿轮=设置页） -->
		<view class="mi-topbar" :style="topbarStyle">
			<text class="mi-top-title" :style="titleStyle">PLPL</text>
			<view class="mi-topbar-flex"></view>
			<view class="mi-top-btn" @click="toggleTheme">
				<text class="mi-top-glyph" :style="glyphStyle">{{ dark ? sunGlyph : moonGlyph }}</text>
			</view>
			<view class="mi-top-btn" @click="openSetting">
				<text class="mi-top-glyph" :style="glyphStyle">{{ gearGlyph }}</text>
			</view>
			<view class="mi-top-tail"></view>
		</view>

		<scroll-view class="mi-scroll">
			<view class="mi-body" :style="bodyStyle">
				<!-- 资料卡：头像 + 昵称/LV/大会员 + 硬币/经验 + 经验条 + 「>」 -->
				<view class="mi-profile" @click="openMemberOrLogin">
					<view class="mi-avatar-wrap">
						<network-img v-if="isLogin" :src="face" width="85px" height="85px" radius="42.5px"></network-img>
						<view v-else class="mi-avatar-default">
							<text class="mi-avatar-glyph">{{ personGlyph }}</text>
						</view>
					</view>
					<view class="mi-profile-info">
						<view class="mi-name-row">
							<text class="mi-name" :style="nameStyle" :max-lines="1">{{ isLogin ? uname : '点击头像登录' }}</text>
							<view v-if="isLogin" class="mi-lv" :style="lvBgStyle">
								<text class="mi-lv-text">LV{{ levelText }}</text>
							</view>
							<view v-if="isLogin && isVip" class="mi-vip">
							<text class="mi-vip-text">{{ vipText }}</text>
							</view>
						</view>
						<view v-if="isLogin" class="mi-coin-row">
							<text class="mi-coin-label" :style="secondaryStyle">硬币 </text>
							<text class="mi-coin-num" :style="statNumStyle">{{ moneyText }}</text>
							<text class="mi-coin-label" :style="secondaryStyle">    经验 </text>
							<text class="mi-coin-num" :style="statNumStyle">{{ expText }}</text>
						</view>
						<!-- 经验条：左段主色填充（比例 = current/next），余下浅底（基线形态） -->
						<view v-if="isLogin" class="mi-exp-bar" :style="expBarStyle">
							<view class="mi-exp-fill" :style="expFillStyle"></view>
						</view>
					</view>
					<view class="mi-chevron" @click.stop="openMemberOrLogin">
						<text class="mi-chevron-glyph" :style="secondaryStyle">{{ chevronGlyph }}</text>
					</view>
				</view>

				<!-- 三列统计：动态/关注/粉丝（可点，数值主色加粗） -->
				<view class="mi-stats">
					<view class="mi-stat-cell" @click="openDynamics">
						<text class="mi-stat-num" :style="statNumStyle">{{ statText(dynamicCount) }}</text>
						<text class="mi-stat-label" :style="secondaryStyle">动态</text>
					</view>
					<view class="mi-stat-cell" @click="openFollow">
						<text class="mi-stat-num" :style="statNumStyle">{{ statText(following) }}</text>
						<text class="mi-stat-label" :style="secondaryStyle">关注</text>
					</view>
					<view class="mi-stat-cell" @click="openFan">
						<text class="mi-stat-num" :style="statNumStyle">{{ statText(follower) }}</text>
						<text class="mi-stat-label" :style="secondaryStyle">粉丝</text>
					</view>
				</view>

				<!-- 四入口一行四列（基线 P5_mine：图标在上标签在下，金色线性图标） -->
				<view class="mi-grid">
					<view class="mi-grid-cell" @click="openGrid('/pages/history/history')">
						<text class="mi-grid-glyph" :style="goldGlyphStyle">{{ historyGlyph }}</text>
						<text class="mi-grid-label" :style="gridLabelStyle">观看记录</text>
					</view>
					<view class="mi-grid-cell" @click="openGrid('/pages/fav/fav')">
						<text class="mi-grid-glyph" :style="goldGlyphStyle">{{ starGlyph }}</text>
						<text class="mi-grid-label" :style="gridLabelStyle">我的收藏</text>
					</view>
					<view class="mi-grid-cell" @click="openGrid('/pages/subscription/subscription')">
						<text class="mi-grid-glyph" :style="goldGlyphStyle">{{ subsGlyph }}</text>
						<text class="mi-grid-label" :style="gridLabelStyle">我的订阅</text>
					</view>
					<view class="mi-grid-cell" @click="openGrid('/pages/later/later')">
						<text class="mi-grid-glyph" :style="goldGlyphStyle">{{ laterGlyph }}</text>
						<text class="mi-grid-label" :style="gridLabelStyle">稍后再看</text>
					</view>
				</view>

				<view class="mi-divider" :style="dividerStyle"></view>

				<!-- 收藏夹区：标题行「收藏夹 N」（整行跳 fav 列表）+ 半宽纵向小卡两列流（fav-folder-mini） -->
				<view v-if="isLogin" class="mi-fav">
					<view class="mi-fav-head" @click="openFavList">
						<text class="mi-fav-title" :style="titleStyle">收藏夹 </text>
						<text class="mi-fav-count" :style="goldStyle">{{ folderCount.toString() }}</text>
					</view>
					<view class="mi-fav-grid">
						<view
							v-for="(folder, index) in folders"
							:key="folder.id"
							class="mi-fav-cell"
							:style="index % 2 == 0 ? 'margin-right:12px;' : ''"
						>
							<fav-folder-mini
								:cover="folder.cover"
								:title="folder.title"
								:media-count="folder.mediaCount"
								:cover-width="favCardWidth"
								:cover-height="favCardHeight"
								:radius="6"
								@tap="openFavDetail(folder.id)"
							></fav-folder-mini>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import NetworkImg from '../../components/network-img/network-img.uvue'
import FavFolderMini from '../../components/fav/fav-folder-mini.uvue'
import { fetchNavUser, fetchNavStat } from '../../api/user-center.uts'
import { fetchFavFolder } from '../../api/fav.uts'
import { FavFolderItem } from '../../models/fav.uts'
import { NavUserInfo } from '../../models/user-center.uts'
import { userState } from '../../stores/user.uts'
import { refreshLoginState } from '../../composables/useLogin.uts'
import {
	isDarkMode, setThemeMode, pageBackground, textPrimary, textSecondary,
	THEME_MODE_LIGHT, THEME_MODE_DARK, withAlpha
} from '../../utils/theme.uts'
import { statusBarPaddingTop, statusBarHeight, safeAreaBottom } from '../../utils/safeArea.uts'

/**
 * 我的页（源头：lib/pages/mine/{view,controller}.dart；视觉以基线 P5_mine 为准——
 * 基线为改版后的形态：资料卡（头像/昵称/LV/大会员/硬币/经验条+「>」）、三列统计、
 * 四宫格、收藏夹卡片列表，源仓库 view.dart 为旧版简化形态，按基线实现）。
 *
 * 登录态：stores/user.uts（P2）+ onShow 静默校正（refreshLoginState）后重取 nav/navStat/收藏夹。
 * 主题切换：真实切换（源 onChangeTheme 三态规则：dark↔light、system→按当前系统亮暗反转），
 * 写回 SK.themeMode 并驱动本页样式重算；其余页面在重新进入时按 theme.uts 即时读值生效。
 * 设置齿轮：跳 /pages/setting/setting（P10 已交付）。
 * 图标：月亮/太阳/齿轮等 p-icon 未收录，用 Material Icons 码点直渲。码点权威 = 本机 Flutter
 * 3.3.10 SDK icons.dart——该 SDK 捆绑的 MaterialIcons 字体为 2022 重生成版，码点布局与 Google
 * 旧码表整体不同（旧码表 e8b8 在本字体是 delete_sharp），已逐项反查 icons.dart 核对。
 * 基线 P5_mine 图标为线性描边风格 → 一律取 *_outlined 变体：
 * dark_mode_outlined=EF9F / wb_sunny_outlined=F4BC / settings_outlined=F36E /
 * history_outlined=F102 / star_border=E5FA / subscriptions_outlined=F3FB /
 * watch_later_outlined=F4B1 / chevron_right=E15F / person=E491。
 *
 * 金色点缀（基线实测像素）：旧 APK「我的」页不随主题色——四入口图标/收藏夹计数用暗金
 * #7A6017，经验条填充 #6E540A/底 #DCB969，统计数字/硬币经验值为近黑非主题色。
 */
const moonGlyph: string = '\uef9f'
const sunGlyph: string = '\uf4bc'
const gearGlyph: string = '\uf36e'
const historyGlyph: string = '\uf102'
const starGlyph: string = '\ue5fa'
const subsGlyph: string = '\uf3fb'
const laterGlyph: string = '\uf4b1'
const chevronGlyph: string = '\ue15f'
const personGlyph: string = '\ue491'

/** 收藏夹半宽卡（基线 P5_mine 实测：封面≈44%屏宽、宽高比≈1.7、小圆角；两列、列距12） */
const favCardWidth = ((): number => {
	try {
		const info = uni.getWindowInfo()
		return Math.round((info.windowWidth - 40 - 12) / 2)
	} catch (e) {
		return 214
	}
})()
const favCardHeight: number = Math.round(favCardWidth / 1.7)

/** 基线固定金色点缀（不随主题色） */
const GOLD_ACCENT: string = '#7A6017'
const GOLD_EXP_FILL: string = '#6E540A'
const GOLD_EXP_TRACK: string = '#DCB969'

/** 本页主题态：切主题后立即重算样式（其他页面重进时生效） */
const dark = ref<boolean>(isDarkMode())

const face = ref<string>('')
const uname = ref<string>('')
const vipStatus = ref<number>(0)
const vipType = ref<number>(0)
const money = ref<number>(0)
const level = ref<number>(0)
const currentExp = ref<number>(0)
const nextExp = ref<number>(0)
const dynamicCount = ref<number>(-1)
const following = ref<number>(-1)
const follower = ref<number>(-1)
const folders = ref<Array<FavFolderItem>>([])
const folderCount = ref<number>(0)
const loadingData = ref<boolean>(false)

const isLogin = computed((): boolean => userState.isLogin)

const pageStyle = computed((): string => {
	// 读取 dark.value 建立响应依赖：toggleTheme 后本页所有样式 computed 重算（主题即时生效）
	dark.value
	return 'background-color:' + pageBackground() + ';'
})
const topbarStyle = computed((): string => {
	dark.value
	// border-box：高度含状态栏避让 padding（height = top + 56，内容区恒 56——home.uvue 同款坑）
	return 'height:' + (statusBarHeight() + 56).toString() + 'px;' + statusBarPaddingTop(0)
})
const glyphStyle = computed((): string => {
	dark.value
	return 'color:' + textPrimary() + ';'
})
const nameStyle = computed((): string => {
	dark.value
	// 大会员昵称品牌粉（基线 vip 昵称高亮；色值取 bilibili 品牌粉）
	return 'color:' + (isLogin.value && vipStatus.value == 1 ? '#FB7299' : textPrimary()) + ';'
})
const secondaryStyle = computed((): string => {
	dark.value
	return 'color:' + textSecondary() + ';'
})
const goldGlyphStyle = computed((): string => {
	dark.value
	return 'color:' + GOLD_ACCENT + ';font-family:MaterialIcons;'
})
const goldStyle = computed((): string => {
	dark.value
	return 'color:' + GOLD_ACCENT + ';'
})
const statNumStyle = computed((): string => {
	dark.value
	return 'color:' + textPrimary() + ';'
})
const gridLabelStyle = computed((): string => {
	dark.value
	return 'color:' + textPrimary() + ';'
})
const titleStyle = computed((): string => {
	dark.value
	return 'color:' + textPrimary() + ';'
})
const dividerStyle = computed((): string => {
	dark.value
	return 'background-color:' + withAlpha(textSecondary(), 0.15) + ';'
})
const expBarStyle = computed((): string => {
	dark.value
	return 'background-color:' + GOLD_EXP_TRACK + ';'
})
const expFillStyle = computed((): string => {
	dark.value
	return 'width:' + expPercent().toString() + '%;background-color:' + GOLD_EXP_FILL + ';'
})
const lvBgStyle = computed((): string => 'background-color:' + lvColor(level.value) + ';')
const bodyStyle = computed((): string => 'padding-bottom:' + (safeAreaBottom() + 24).toString() + 'px;')

const levelText = computed((): string => level.value.toString())
const moneyText = computed((): string => money.value.toString())
const expText = computed((): string => currentExp.value.toString() + '/' + nextExp.value.toString())
const isVip = computed((): boolean => vipStatus.value == 1)
/** 会员文案：年度（vipType=2）为「超大会员」（基线徽章语义；官方徽章图形态后续接 vip_label 图） */
const vipText = computed((): string => vipStatus.value == 1 && vipType.value >= 2 ? '超大会员' : '大会员')

function expPercent(): number {
	if (nextExp.value <= 0) {
		return 0
	}
	const percent = Math.floor(currentExp.value / nextExp.value * 100)
	if (percent < 0) {
		return 0
	}
	if (percent > 100) {
		return 100
	}
	return percent
}

/** 等级徽标配色（B 站惯例近似：0-3 蓝 / 4-5 橙 / 6+ 红；视觉等价，登记差异） */
function lvColor(lv: number): string {
	if (lv >= 6) {
		return '#F26D6D'
	}
	if (lv >= 4) {
		return '#F6A55C'
	}
	return '#6FC2F2'
}

function statText(value: number): string {
	return value < 0 ? '-' : value.toString()
}

// ---------------------------------------------------------------- 数据

async function loadAll() {
	if (!userState.isLogin) {
		resetProfile()
		return
	}
	if (loadingData.value) {
		return
	}
	loadingData.value = true
	const userRes = await fetchNavUser()
	if (userRes.status && userRes.data != null) {
		const info = userRes.data as NavUserInfo
		if (info.isLogin) {
			face.value = info.face
			uname.value = info.uname
			vipStatus.value = info.vipStatus
			vipType.value = info.vipType
			money.value = info.money
			level.value = info.level.currentLevel
			currentExp.value = info.level.currentExp
			nextExp.value = info.level.nextExp
		} else {
			resetProfile()
		}
	}
	const statRes = await fetchNavStat()
	if (statRes.status) {
		following.value = statRes.stat.following
		follower.value = statRes.stat.follower
		dynamicCount.value = statRes.stat.dynamicCount
	}
	const favRes = await fetchFavFolder(userState.info.mid, 1, 10)
	if (favRes.status) {
		folders.value = favRes.items
		folderCount.value = favRes.page.count
	}
	loadingData.value = false
}

function resetProfile() {
	face.value = ''
	uname.value = ''
	vipStatus.value = 0
	vipType.value = 0
	money.value = 0
	level.value = 0
	currentExp.value = 0
	nextExp.value = 0
	dynamicCount.value = -1
	following.value = -1
	follower.value = -1
	folders.value = []
	folderCount.value = 0
}

onShow(async () => {
	// 登录/退出返回后静默校正登录态再重取（源 userLogin.listen 同款时机）
	await refreshLoginState()
	loadAll()
})

// ---------------------------------------------------------------- 交互

/** 头像/资料卡/「>」：未登录 → 登录页；已登录 → 本人主页 */
function openMemberOrLogin() {
	if (!userState.isLogin) {
		uni.navigateTo({ url: '/pages/login/login' })
		return
	}
	const mid = userState.info.mid
	if (mid <= 0) {
		return
	}
	uni.navigateTo({ url: '/pages/member/member?mid=' + mid.toString() })
}

/** 三列统计：未登录 toast（源同款）；已登录携 mid 跳转 */
function openDynamics() {
	if (!userState.isLogin) {
		uni.showToast({ title: '账号未登录', icon: 'none' })
		return
	}
	uni.navigateTo({ url: '/pages/member-dynamics/member-dynamics?mid=' + userState.info.mid.toString() })
}

function openFollow() {
	if (!userState.isLogin) {
		uni.showToast({ title: '账号未登录', icon: 'none' })
		return
	}
	uni.navigateTo({ url: '/pages/follow/follow?mid=' + userState.info.mid.toString() })
}

function openFan() {
	if (!userState.isLogin) {
		uni.showToast({ title: '账号未登录', icon: 'none' })
		return
	}
	uni.navigateTo({ url: '/pages/fan/fan?mid=' + userState.info.mid.toString() })
}

/** 四宫格：直接跳转，目标页自处理登录态（源 media 入口同款） */
function openGrid(path: string) {
	uni.navigateTo({ url: path })
}

function openFavList() {
	uni.navigateTo({ url: '/pages/fav/fav' })
}

function openFavDetail(mediaId: number) {
	uni.navigateTo({ url: '/pages/fav-detail/fav-detail?mediaId=' + mediaId.toString() + '&isOwner=1' })
}

/**
 * 主题切换（真实写回 SK.themeMode，源 onChangeTheme 三态规则）：
 * dark→light；light→dark；system→按当前系统亮暗反转；切换后本页样式即时重算。
 */
function toggleTheme() {
	const mode = isDarkMode()
	if (mode) {
		setThemeMode(THEME_MODE_LIGHT)
	} else {
		setThemeMode(THEME_MODE_DARK)
	}
	dark.value = isDarkMode()
	uni.showToast({ title: dark.value ? '已切换深色模式' : '已切换浅色模式', icon: 'none' })
}

/** 设置齿轮：跳设置主页（P10 已交付，/pages/setting/setting） */
function openSetting() {
	uni.navigateTo({
		url: '/pages/setting/setting',
		fail: () => {
			uni.showToast({ title: '设置页打开失败，请重试', icon: 'none' })
		}
	})
}
</script>

<style>
	.mi {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.mi-topbar {
		height: 56px;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 16px;
	}
	/* 标题「PLPL」：源 AppBar title（fontSize 17 / bold / Jura-Bold / height 2.8） */
	.mi-top-title {
		font-family: Jura-Bold;
		font-size: 17px;
		font-weight: bold;
	}
	.mi-topbar-flex {
		flex: 1;
	}
	.mi-top-tail {
		width: 10px;
	}
	.mi-top-btn {
		width: 44px;
		height: 44px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.mi-top-glyph {
		font-family: MaterialIcons;
		font-size: 22px;
		line-height: 22px;
	}
	.mi-scroll {
		flex: 1;
	}
	.mi-body {
		display: flex;
		flex-direction: column;
	}
	/* 资料卡：头像左 + 信息中 + 「>」右（基线 P5_mine） */
	.mi-profile {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 10px;
		margin-left: 20px;
		margin-right: 16px;
	}
	.mi-avatar-wrap {
		width: 85px;
		height: 85px;
	}
	.mi-avatar-default {
		width: 85px;
		height: 85px;
		border-radius: 42.5px;
		background-color: #F0EFF4;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.mi-avatar-glyph {
		font-family: MaterialIcons;
		font-size: 40px;
		color: #B0B6C0;
	}
	.mi-profile-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		margin-left: 14px;
		margin-right: 8px;
	}
	.mi-name-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.mi-name {
		font-size: 18px;
		font-weight: 600;
		line-height: 26px;
	}
	.mi-lv {
		margin-left: 6px;
		padding-left: 6px;
		padding-right: 6px;
		padding-top: 2px;
		padding-bottom: 2px;
		border-radius: 4px;
	}
	.mi-lv-text {
		font-size: 10px;
		color: #FFFFFF;
	}
	.mi-vip {
		margin-left: 6px;
		padding-left: 8px;
		padding-right: 8px;
		padding-top: 2px;
		padding-bottom: 2px;
		border-radius: 8px;
		background-color: #FB7299;
	}
	.mi-vip-text {
		font-size: 10px;
		color: #FFFFFF;
	}
	.mi-coin-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 6px;
	}
	.mi-coin-label {
		font-size: 12px;
	}
	.mi-coin-num {
		font-size: 12px;
	}
	.mi-exp-bar {
		height: 4px;
		margin-top: 8px;
	}
	.mi-exp-fill {
		height: 4px;
	}
	.mi-chevron {
		width: 32px;
		height: 44px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.mi-chevron-glyph {
		font-family: MaterialIcons;
		font-size: 22px;
		line-height: 22px;
	}
	/* 三列统计（源 GridView.count 3 列；数值主色加粗 16、标签 12 次要色） */
	.mi-stats {
		display: flex;
