		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.brand-mark-text {
		font-size: 44px;
		font-weight: bold;
		color: #FFFFFF;
	}
	.brand-name {
		font-size: 22px;
		font-weight: bold;
		color: #18191C;
		margin-top: 14px;
	}
	.brand-slogan {
		font-size: 13px;
		color: #8A94A6;
		margin-top: 6px;
	}
	.guide {
		display: flex;
		flex-direction: column;
		margin-top: 36px;
	}
	.guide-title {
		font-size: 18px;
		font-weight: bold;
		color: #18191C;
	}
	.guide-desc {
		font-size: 13px;
		line-height: 20px;
		color: #8A94A6;
		margin-top: 8px;
	}
	.primary {
		height: 48px;
		border-radius: 24px;
		margin-top: 20px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.primary-text {
		font-size: 16px;
		font-weight: bold;
		color: #FFFFFF;
	}
	.state-row {
		display: flex;
		flex-direction: row;
		justify-content: center;
		margin-top: 12px;
	}
	.state-text {
		font-size: 12px;
	}
	.divider {
		height: 1px;
		background-color: #EEF0F3;
		margin-top: 28px;
	}
	.closed-item {
		height: 52px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.closed-badge {
		font-size: 12px;
		color: #C2C6CE;
		border-width: 1px;
		border-style: solid;
		border-color: #E3E6EA;
		border-radius: 10px;
		padding-left: 8px;
		padding-right: 8px;
		padding-top: 2px;
		padding-bottom: 2px;
	}
	.closed-note {
		font-size: 12px;
		line-height: 18px;
		color: #A7ADB8;
		margin-top: 4px;
	}
	.qr-entry-title {
		font-size: 15px;
		color: #18191C;
	}
	.qr-panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 16px;
	}
	.qr-card {
		position: relative;
		padding-left: 12px;
		padding-right: 12px;
		padding-top: 12px;
		padding-bottom: 12px;
		background-color: #FFFFFF;
		border-width: 1px;
		border-style: solid;
		border-color: #E3E6EA;
		border-radius: 12px;
	}
	.qr-mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(255, 255, 255, 0.94);
		border-radius: 12px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.qr-mask-btn {
		padding-left: 16px;
		padding-right: 16px;
		padding-top: 7px;
		padding-bottom: 7px;
		border-radius: 16px;
	}
	.qr-mask-btn-text {
		font-size: 13px;
		font-weight: bold;
		color: #FFFFFF;
	}
	.qr-status {
		font-size: 13px;
		margin-top: 12px;
	}
	.qr-hint {
		font-size: 12px;
		color: #A7ADB8;
		margin-top: 6px;
	}
	.spacer {
		flex: 1;
	}
	.footer {
		font-size: 12px;
		color: #A7ADB8;
		text-align: center;
		margin-bottom: 18px;
	}
</style>
