import CookieManager from 'android.webkit.CookieManager'

/**
 * 平台 cookie jar 读写（Android）。
 *
 * 存在理由：uni-app x 不提供读取/清空 cookie jar 的 API（`uni.request` 只回传响应里的
 * Set-Cookie 数组，见官方「网络概述 / Cookie 共享」与框架类型定义），而登录由 web-view
 * 写入系统 CookieManager、不经过 `uni.request` 响应，因此写接口所需的 `bili_jct`
 * 只能从系统 jar 直接读取。jar 与请求层共用（同一 CookieManager 实例），读到的即请求实际携带的。
 */

/** 读取指定 URL 在平台 jar 中的 cookie 串（形如 `a=1; b=2`）；无 cookie 返回空串 */
export function getCookie(url: string): string {
	const manager = CookieManager.getInstance()
	const value: string | null = manager.getCookie(url)
	if (value == null) {
		return ''
	}
	return value as string
}

/**
 * 清空平台 jar 全部 cookie 并落盘（退出登录）。
 * `removeAllCookies` 的回调在本场景无用，传 null 即「清完不通知」。
 */
export function clearAllCookies(): boolean {
	const manager = CookieManager.getInstance()
	manager.removeAllCookies(null)
	manager.flush()
	return true
}
