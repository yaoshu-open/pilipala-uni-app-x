		width: 56px;
		height: 56px;
		border-radius: 28px;
		background-color: #DCE2DC;
	}
	.ei-tree1-trunk {
		position: absolute;
		left: 32px;
		top: 88px;
		width: 8px;
		height: 26px;
		border-radius: 3px;
		background-color: #C7CFC7;
	}
	/* 右树（小一号） */
	.ei-tree2-crown {
		position: absolute;
		left: 238px;
		top: 46px;
		width: 44px;
		height: 44px;
		border-radius: 22px;
		background-color: #DCE2DC;
	}
	.ei-tree2-trunk {
		position: absolute;
		left: 256px;
		top: 88px;
		width: 7px;
		height: 22px;
		border-radius: 3px;
		background-color: #C7CFC7;
	}
	/* 人物 A：坐姿看手机（绿衣） */
	.ei-p-a-head {
		position: absolute;
		left: 84px;
		top: 110px;
		width: 18px;
		height: 18px;
		border-radius: 9px;
		background-color: #23262E;
	}
	.ei-p-a-body {
		position: absolute;
		left: 78px;
		top: 130px;
		width: 30px;
		height: 30px;
		border-radius: 10px;
		background-color: #27B978;
	}
	/* 人物 B：站立（深灰衣） */
	.ei-p-b-head {
		position: absolute;
		left: 142px;
		top: 96px;
		width: 18px;
		height: 18px;
		border-radius: 9px;
		background-color: #23262E;
	}
	.ei-p-b-body {
		position: absolute;
		left: 138px;
		top: 116px;
		width: 26px;
		height: 44px;
		border-radius: 10px;
		background-color: #3A4150;
	}
	/* 人物 C：行走（绿衣） */
	.ei-p-c-head {
		position: absolute;
		left: 200px;
		top: 102px;
		width: 18px;
		height: 18px;
		border-radius: 9px;
		background-color: #23262E;
	}
	.ei-p-c-body {
		position: absolute;
		left: 195px;
		top: 122px;
		width: 28px;
		height: 38px;
		border-radius: 10px;
		background-color: #27B978;
	}
	.ei-text {
		margin-top: 20px;
	}
	.ei-text-plain {
		font-size: 15px;
	}
	.ei-text-pill {
		font-size: 15px;
		padding-left: 24px;
		padding-right: 24px;
		padding-top: 10px;
		padding-bottom: 10px;
		border-radius: 22px;
		background-color: #EAE6DB;
		color: #6E6E3C;
	}
	.ei-retry {
		margin-top: 24px;
		height: 40px;
		padding-left: 28px;
		padding-right: 28px;
		border-radius: 20px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.ei-retry-text {
		font-size: 15px;
	}
</style>
