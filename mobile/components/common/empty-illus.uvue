<template>
	<view class="ei" @click="onClickSurface">
		<!-- 空态插画：两树 + 三人（扁平 view 绘制，形态对齐源 NoData/HttpError 的插画占位） -->
		<view class="ei-illus">
			<view class="ei-ground"></view>
			<!-- 左树 -->
			<view class="ei-tree1-crown"></view>
			<view class="ei-tree1-trunk"></view>
			<!-- 右树 -->
			<view class="ei-tree2-crown"></view>
			<view class="ei-tree2-trunk"></view>
			<!-- 三人：坐（绿）/ 立（灰）/ 行（绿） -->
			<view class="ei-p-a-head"></view>
			<view class="ei-p-a-body"></view>
			<view class="ei-p-b-head"></view>
			<view class="ei-p-b-body"></view>
			<view class="ei-p-c-head"></view>
			<view class="ei-p-c-body"></view>
		</view>
		<text v-if="text.length > 0" class="ei-text" :class="pill ? 'ei-text-pill' : 'ei-text-plain'" :style="textStyle">{{ text }}</text>
		<view v-if="retry" class="ei-retry" :style="retryStyle" @click="onRetry">
			<text class="ei-retry-text" :style="retryTextStyle">{{ retryText }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { themeColor, currentThemeIndex, textPrimary, withAlpha } from '../../utils/theme.uts'

/**
 * 空态插画组件（源头：lib/common/widgets/no_data.dart 的插画 + 文案形态；
 * 基线 P5 fan/subscription/blacklist/follow_search 空态统一为「树+三人插画 + 文案」）。
 *
 * 形态三档：
 *  - pill=false + retry=false：插画 + 纯文案（fan 空态「没有数据」）
 *  - pill=true：文案装进浅米色胶囊（subscription 空态，源 HttpError(btnText) 形态）
 *  - retry=true：附「点击重试」胶囊按钮（blacklist / follow_search 空态，源同款）
 *
 * 插画颜色取基线实测值（扁平矢量固定色，明暗两态同色——与源一致，不做暗色反转）。
 */
const props = defineProps({
	text: { type: String, default: '' },
	pill: { type: Boolean, default: false },
	retry: { type: Boolean, default: false },
	retryText: { type: String, default: '点击重试' }
})

const emit = defineEmits(['retry'])

const primary = themeColor(currentThemeIndex())
const textStyle = computed((): string => 'color:' + textPrimary() + ';')
/** 重试胶囊：浅底（主色 8% 透明）+ 主色字，形态对齐 p-http-error 的 tonal 按钮 */
const retryStyle = computed((): string => 'background-color:' + withAlpha(primary, 0.08) + ';')
const retryTextStyle = computed((): string => 'color:' + primary + ';')

/** 插画整体点击与重试按钮等效（源 HttpError 的 fn 也允许整块触发） */
function onClickSurface() {
	if (props.retry) {
		emit('retry')
	}
}

function onRetry() {
	emit('retry')
}
</script>

<style>
	.ei {
		/* 源 HttpError = SizedBox(height:400) 顶盒 + 内容盒内居中（基线实测空态块位于 y26-47%）；
		 * 禁用 flex:1 整页居中（会把空态块推到屏中部，偏离基线） */
		height: 400px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}
	.ei-illus {
		width: 300px;
		height: 170px;
		position: relative;
	}
	/* 地面平台 */
	.ei-ground {
		position: absolute;
		left: 20px;
		bottom: 0px;
		width: 260px;
		height: 12px;
		border-radius: 6px;
		background-color: #E3E8E3;
	}
	/* 左树：树冠 + 树干 */
	.ei-tree1-crown {
		position: absolute;
