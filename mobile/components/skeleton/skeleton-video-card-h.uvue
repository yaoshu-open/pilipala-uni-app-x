<template>
	<view class="sk-card-h">
		<skeleton>
			<view class="sk-card-h-body">
				<skeleton-block :width="coverWidth" :height="coverHeightText" radius="10px"></skeleton-block>
				<view class="sk-card-h-info">
					<skeleton-block width="200px" height="11px"></skeleton-block>
					<view class="sk-card-h-gap5"></view>
					<skeleton-block width="150px" height="13px"></skeleton-block>
					<view class="sk-card-h-spacer"></view>
					<skeleton-block width="100px" height="13px"></skeleton-block>
					<view class="sk-card-h-gap5"></view>
					<view class="sk-card-h-row">
						<skeleton-block width="40px" height="13px"></skeleton-block>
						<view class="sk-card-h-gap8"></view>
						<skeleton-block width="40px" height="13px"></skeleton-block>
					</view>
				</view>
			</view>
		</skeleton>
	</view>
</template>

<script setup lang="uts">
import Skeleton from './skeleton.uvue'
import SkeletonBlock from './skeleton-block.uvue'

/**
 * 横向视频卡骨架屏。视觉出处：`lib/common/skeleton/video_card_h.dart`
 *  - 外边距：safeSpace=12（左右）、上下 7；
 *  - 卡高 = 列宽 / aspectRatio(16/10)，列宽 = (可用宽 - cardSpace*6)/2；卡宽取满父容器；
 *  - 封面：AspectRatio(16/10) + 圆角 imgRadius=10；
 *  - 信息区：fromLTRB(10, 4, 6, 4)；条块 200×11（下 5）、150×13、Spacer、100×13（下 5）、40×13 + 8 + 40×13。
 *
 * 平台约束（允许差异）：源卡高由父宽在 build 期推导，目标端组件读不到父宽——
 * 与 `skeleton-video-card-v` 同口径，改由 coverHeight 传入；不传时按屏幕宽推导
 *（windowWidth - 左右 24 - cardSpace*6）/ 2 / 1.6，对应常见 360~430 宽屏的列表整行场景。
 */
const props = defineProps({
	coverHeight: { type: Number, default: 0 }
})

function autoCoverHeight(): number {
	try {
		const info = uni.getWindowInfo()
		return ((info.windowWidth - 24 - 48) / 2) / 1.6
	} catch (e) {
		return 98
	}
}

const heightPx: number = props.coverHeight > 0 ? props.coverHeight : autoCoverHeight()
const coverHeightText: string = Math.round(heightPx).toString() + 'px'
const coverWidth: string = Math.round(heightPx * 1.6).toString() + 'px'
</script>

<style>
	.sk-card-h {
		background-color: #FFFFFF;
	}
	.sk-card-h-body {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		padding-left: 12px;
		padding-right: 12px;
		padding-top: 7px;
		padding-bottom: 7px;
	}
	.sk-card-h-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding-left: 10px;
		padding-top: 4px;
		padding-right: 6px;
		padding-bottom: 4px;
	}
	.sk-card-h-gap5 {
		height: 5px;
	}
	.sk-card-h-gap8 {
		width: 8px;
		height: 1px;
	}
	.sk-card-h-spacer {
		flex: 1;
	}
	.sk-card-h-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
</style>
