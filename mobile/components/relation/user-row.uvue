<template>
	<view class="ur" @click="onRow">
		<!-- 头像 + 直播闪电角标（角标为 view 包裹，image 不直挂事件） -->
		<view class="ur-avatar-wrap">
			<network-img :src="face" width="45px" height="45px" :radius="avatarRadius"></network-img>
			<view v-if="live" class="ur-live" @click.stop="onLive">
				<text class="ur-live-glyph">{{ boltGlyph }}</text>
			</view>
		</view>
		<view class="ur-body">
			<view class="ur-name-row">
				<text class="ur-name" :style="nameStyle" :max-lines="1">{{ uname }}</text>
				<text v-if="verifyText.length > 0" class="ur-verify" :style="verifyStyle" :max-lines="1">{{ verifyText }}</text>
			</view>
			<text class="ur-sub" :style="subStyle" :max-lines="1">{{ subtitle }}</text>
		</view>
		<!-- 右侧动作槽：plain=「已关注」纯灰文字（基线 P5_follow 无底）/ pill=灰底胶囊 / text=「移除」主色文字钮；空则不渲染 -->
		<view v-if="actionText.length > 0 && actionTone == 'plain'" class="ur-action-text" @click.stop="onAction">
			<text class="ur-action-text-inner" :style="plainTextStyle">{{ actionText }}</text>
		</view>
		<view v-if="actionText.length > 0 && actionTone == 'pill'" class="ur-action-pill" :style="pillStyle" @click.stop="onAction">
			<text class="ur-action-pill-text" :style="pillTextStyle">{{ actionText }}</text>
		</view>
		<view v-else-if="actionText.length > 0 && actionTone == 'text'" class="ur-action-text" @click.stop="onAction">
			<text class="ur-action-text-inner" :style="actionTextStyle">{{ actionText }}</text>
		</view>
		<view v-else class="ur-action-none"></view>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import NetworkImg from '../network-img/network-img.uvue'
import { themeColor, currentThemeIndex, textPrimary, textSecondary, skeletonBase } from '../../utils/theme.uts'
/**
 * 用户行（follow / fan / follow-search / blacklist 共用）。
 *
 * 视觉出处：源 lib/pages/follow/widgets/follow_item.dart（ListTile：头像 45 圆形 +
 * 昵称 14 + 签名单行截断 + 右侧动作）；基线 P5_follow 实测：头像 ~48 圆形、右动作为
 * 浅灰底胶囊「已关注」（源 onInverseSurface 底 + outline 字，即 skeletonBase/textSecondary 等价 token）。
 *
 * 直播闪电角标：基线 follow 首条头像右下蓝底白闪电；数据源 live_status 标准关注接口
 * 不保证返回，由调用方按解析值传入（缺省不显示，不脑补直播态）。
 * 闪电用 Material Icons 码点 U+EA0B（bolt，已核对项目字体 cmap 存在）。
 */
const props = defineProps({
	face: { type: String, default: '' },
	uname: { type: String, default: '' },
	/** 副标题：签名（follow/fan/search）或拉黑时间（blacklist） */
	subtitle: { type: String, default: '' },
	/** 直播中角标 */
	live: { type: Boolean, default: false },
	/** 认证说明（official_verify.desc；type<0 传空） */
	verifyText: { type: String, default: '' },
	/** 右侧动作文案；空 = 无动作（fan 行） */
	actionText: { type: String, default: '' },
	/** 动作形态：pill=灰底胶囊（已关注）/ text=主色文字钮（移除） */
	actionTone: { type: String, default: 'pill' }
})

const emit = defineEmits(['tap', 'action', 'tap-live'])

// 特别关注闪电（源 Icons.bolt；本机 Flutter 3.3.10 icons.dart 码点 E0EE——旧码表 ea0b 在本字体是 highlight_alt_sharp）
const boltGlyph: string = '\ue0ee'
const primary = themeColor(currentThemeIndex())
const avatarRadius: string = '22.5px'

const nameStyle = computed((): string => 'color:' + textPrimary() + ';')
const subStyle = computed((): string => 'color:' + textSecondary() + ';')
const verifyStyle = computed((): string => 'color:' + primary + ';')
const pillTextStyle = computed((): string => 'color:' + textSecondary() + ';')
const pillStyle = computed((): string => 'background-color:' + skeletonBase() + ';')
/** 纯文字态（基线 P5_follow「已关注」：浅灰文字、无底、不可点感） */
const plainTextStyle = computed((): string => 'color:' + textSecondary() + ';')
const actionTextStyle = computed((): string => 'color:' + primary + ';')

function onRow() {
	emit('tap')
}

function onAction() {
	emit('action')
}

function onLive() {
	emit('tap-live')
}
</script>

<style>
	.ur {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 16px;
		padding-right: 16px;
		padding-top: 8px;
		padding-bottom: 8px;
		background-color: rgba(0, 0, 0, 0);
	}
	.ur-avatar-wrap {
		position: relative;
		width: 45px;
		height: 45px;
	}
	.ur-live {
		position: absolute;
		right: -2px;
		bottom: -2px;
		width: 17px;
		height: 17px;
		border-radius: 9px;
		background-color: #23A0F0;
		border-style: solid;
		border-width: 2px;
		border-color: #FFFFFF;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.ur-live-glyph {
		font-family: MaterialIcons;
		font-size: 10px;
		line-height: 10px;
		color: #FFFFFF;
	}
	.ur-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		margin-left: 12px;
	}
	.ur-name-row {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.ur-name {
		font-size: 15px;
		line-height: 22px;
	}
	.ur-verify {
		font-size: 11px;
		margin-left: 6px;
		max-width: 120px;
	}
	.ur-sub {
		font-size: 13px;
		line-height: 19px;
		margin-top: 2px;
	}
	.ur-action-pill {
		margin-left: 10px;
		min-height: 30px;
		padding-left: 14px;
		padding-right: 14px;
		border-radius: 6px;
		background-color: #F0EFF4;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.ur-action-pill-text {
		font-size: 12px;
	}
	.ur-action-text {
		margin-left: 10px;
		min-height: 36px;
		padding-left: 12px;
		padding-right: 12px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.ur-action-text-inner {
		font-size: 14px;
	}
	.ur-action-none {
		width: 6px;
	}
</style>
