/** 网络错误提示（源：lib/http/interceptor.dart dioError） */
export function networkErrorText(kind: string): string {
	if (kind == 'timeout') {
		return '网络连接超时，请检查网络设置'
	}
	if (kind == 'connect') {
		return '连接错误，请检查网络设置'
	}
	if (kind == 'cancel') {
		return '请求已被取消，请重新请求'
	}
	return '网络异常，请稍后重试'
}
