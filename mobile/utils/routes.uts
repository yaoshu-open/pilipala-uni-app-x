	// member_coin/member_like=源空壳页（主页面板直接消费接口）。
}

function withQuery(path: string, query: string): string {
	if (query.length == 0) {
		return path
	}
	return path + '?' + query
}

export function navigateTo(path: string, query: string = '') {
	uni.navigateTo({
		url: withQuery(path, query),
		fail: (err) => {
			console.log('[route] navigateTo fail path=' + path + ' err=' + JSON.stringify(err))
		}
	})
}

export function redirectTo(path: string, query: string = '') {
	uni.redirectTo({ url: withQuery(path, query) })
}

export function reLaunch(path: string, query: string = '') {
	uni.reLaunch({ url: withQuery(path, query) })
}

export function navigateBack(delta: number = 1) {
	uni.navigateBack({ delta: delta })
}
