import { strOf, numOf, objOf, strArrayOf } from '../utils/json.uts'
import { durationToSeconds } from '../utils/format.uts'
import { toSecureUrl } from '../utils/url.uts'

/**
 * 搜索域模型（源头：lib/models/search/{hot,suggest,result}.dart、lib/models/common/search_type.dart）。
 *
 * 高亮拆段：接口标题字段携带 `<em class="keyword">…</em>`（suggest 为 `suggest_high_light`）标记，
 * 源头 Em.regTitle 用正则切成 [{type:'em'|'text', text}] 段数组——uts 端用等价的手写扫描器实现
 * （parseTitleSegs），渲染层行内多 text 拼接（em 段主色加粗），与 P4 reply-rich-text 段模式同构。
 */

/** 标题段：type='em' 为命中高亮段，'text' 为普通段 */
export class TitleSeg {
	type: string = 'text'
	text: string = ''
	constructor(type: string, text: string) {
		this.type = type
		this.text = text
	}
}

/** HTML 实体解码（源头 lib/utils/em.dart decodeHtmlEntities 同款替换链） */
export function decodeHtmlEntities(title: string): string {
	return title
		.replaceAll('&lt;', '<')
		.replaceAll('&gt;', '>')
		.replaceAll('&#34;', '"')
		.replaceAll('&#39;', "'")
		.replaceAll('&quot;', '"')
		.replaceAll('&apos;', "'")
		.replaceAll('&nbsp;', ' ')
		.replaceAll('&amp;', '&')
		.replaceAll('&#x27;', "'")
}

/**
 * `<开标签>内容</闭标签>` 段拆分（源头 Em.regTitle 等价）。
 * 手写扫描器逐字符找配对标签：命中 → em 段（内容已解码）；标签之外 → text 段。
 * 结构不完整（缺闭合/悬空 '<'）时按普通文本处理，不抛异常。
 */
export function parseTitleSegs(origin: string): TitleSeg[] {
	const segs: TitleSeg[] = []
	let plain = ''
	let i = 0
	const n = origin.length
	while (i < n) {
		const lt = origin.indexOf('<', i)
		if (lt < 0) {
			plain += origin.substring(i)
			break
		}
		if (lt > i) {
			plain += origin.substring(i, lt)
		}
		const gt = origin.indexOf('>', lt)
		if (gt < 0) {
			// 悬空 '<'：无完整开标签，剩余按普通文本
			plain += origin.substring(lt)
			break
		}
		const closeLt = origin.indexOf('<', gt + 1)
		if (closeLt < 0) {
			// 有开标签无后续 '<'：标签本身丢弃，剩余按普通文本
			i = gt + 1
			continue
		}
		const closeGt = origin.indexOf('>', closeLt)
		if (closeGt < 0) {
			plain += origin.substring(gt + 1)
			break
		}
		const content = origin.substring(gt + 1, closeLt)
		if (plain.length > 0) {
			segs.push(new TitleSeg('text', decodeHtmlEntities(plain)))
			plain = ''
		}
		segs.push(new TitleSeg('em', decodeHtmlEntities(content)))
		i = closeGt + 1
	}
	if (plain.length > 0) {
		segs.push(new TitleSeg('text', decodeHtmlEntities(plain)))
	}
	return segs
}

/** 段数组 → 纯文本标题（等价源 title.replaceAll(RegExp(r'<.*?>'), '')） */
export function segsToPlain(segs: TitleSeg[]): string {
	let text = ''
	for (let i = 0; i < segs.length; i++) {
		text += segs[i].text
	}
	return text
}

// ---------------------------------------------------------------- 搜索类型与筛选项常量

/** 搜索类型（源头 SearchType 枚举 5 项 + 基线图新增「影视」media_ft，共 6 项；顺序=基线 tab 顺序） */
export class SearchTypeDef {
	type: string = ''
	label: string = ''
	constructor(type: string, label: string) {
		this.type = type
		this.label = label
	}
}

export const SEARCH_TYPES: SearchTypeDef[] = [
	new SearchTypeDef('video', '视频'),
	new SearchTypeDef('media_bangumi', '番剧'),
	new SearchTypeDef('media_ft', '影视'),
	new SearchTypeDef('live_room', '直播间'),
	new SearchTypeDef('bili_user', '用户'),
	new SearchTypeDef('article', '专栏')
]

/** 排序档（源头 ArchiveFilterType：totalrank/click/pubdate/dm/stow/scores；'' 表示不传参=默认排序） */
export class OrderOption {
	value: string = ''
	label: string = ''
	constructor(value: string, label: string) {
		this.value = value
		this.label = label
	}
}

