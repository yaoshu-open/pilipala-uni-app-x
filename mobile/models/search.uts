// ---------------------------------------------------------------- 热搜 / 建议

/** 热搜词条（源 HotSearchItem；wordType：4/5 热 · 11 话题 · 8 普通 · 7 直播，角标图走 icon 字段 URL） */
export class HotSearchItem {
	keyword: string = ''
	showName: string = ''
	wordType: number = 0
	icon: string = ''

	static from(raw: UTSJSONObject): HotSearchItem {
		const item = new HotSearchItem()
		item.keyword = strOf(raw, 'keyword')
		item.showName = strOf(raw, 'show_name')
		item.wordType = numOf(raw, 'word_type')
		// 角标图 URL 常为 http 明文，release 包原生 image 会拒载（详见 utils/url.uts）
		item.icon = toSecureUrl(strOf(raw, 'icon'))
		return item
	}
}

/** 建议词条（源 SearchSuggestItem；name 含 suggest_high_light 标记 → nameSegs 段数组） */
export class SuggestItem {
	value: string = ''
	term: string = ''
	nameSegs: TitleSeg[] = []

	static from(raw: UTSJSONObject): SuggestItem {
		const item = new SuggestItem()
		item.value = strOf(raw, 'value')
		item.term = strOf(raw, 'term')
		item.nameSegs = parseTitleSegs(strOf(raw, 'name'))
		return item
	}
}

// ---------------------------------------------------------------- 结果计数

/** 各类结果计数（源 SearchAllModel.topTList；含 media_ft 供「影视」tab 使用） */
export class SearchCounts {
	video: number = 0
	mediaBangumi: number = 0
	mediaFt: number = 0
	liveRoom: number = 0
	biliUser: number = 0
	article: number = 0

	/** 按 search_type 取计数（未知类型返回 0） */
	countOf(type: string): number {
		if (type == 'video') { return this.video }
		if (type == 'media_bangumi') { return this.mediaBangumi }
		if (type == 'media_ft') { return this.mediaFt }
		if (type == 'live_room') { return this.liveRoom }
		if (type == 'bili_user') { return this.biliUser }
		if (type == 'article') { return this.article }
		return 0
	}

	static from(data: UTSJSONObject): SearchCounts {
		const counts = new SearchCounts()
		const top = objOf(data, 'top_tlist')
		if (top == null) {
			return counts
		}
		counts.video = numOf(top, 'video')
		counts.mediaBangumi = numOf(top, 'media_bangumi')
		counts.mediaFt = numOf(top, 'media_ft')
		counts.liveRoom = numOf(top, 'live_room')
		counts.biliUser = numOf(top, 'bili_user')
		counts.article = numOf(top, 'article')
		return counts
	}
}

// ---------------------------------------------------------------- 视频（含 owner/stat 内嵌）

/** UP 信息（源 Owner：mid/author/upic → mid/name/face） */
export class SearchVideoOwner {
	mid: number = 0
	name: string = ''
	face: string = ''
}

/** 视频计数（源 Stat：play→view、danmaku、favorite、review→reply、like） */
export class SearchVideoStat {
	view: number = 0
	danmaku: number = 0
	favorite: number = 0
	reply: number = 0
	like: number = 0
}

export class SearchVideoItem {
	type: string = ''
	aid: number = 0
	bvid: string = ''
	mid: number = 0
	title: string = ''
	titleSegs: TitleSeg[] = []
	description: string = ''
	pic: string = ''
	/** 秒（源 Utils.duration 把 "hh:mm:ss" 转秒，本端 durationToSeconds 同构） */
	duration: number = 0
	pubdate: number = 0
	senddate: number = 0
	videoReview: number = 0
	rcmdReason: string = ''
	owner: SearchVideoOwner = new SearchVideoOwner()
	stat: SearchVideoStat = new SearchVideoStat()

	static from(raw: UTSJSONObject): SearchVideoItem {
		const item = new SearchVideoItem()
		item.type = strOf(raw, 'type')
		item.aid = numOf(raw, 'aid')
		item.bvid = strOf(raw, 'bvid')
		item.mid = numOf(raw, 'mid')
		item.titleSegs = parseTitleSegs(strOf(raw, 'title'))
		item.title = segsToPlain(item.titleSegs)
		item.description = strOf(raw, 'description')
		const pic = strOf(raw, 'pic')
		item.pic = pic.startsWith('//') ? 'https:' + pic : pic
		item.duration = durationToSeconds(strOf(raw, 'duration'))
		item.pubdate = numOf(raw, 'pubdate')
		item.senddate = numOf(raw, 'senddate')
		item.videoReview = numOf(raw, 'video_review')
		item.owner.mid = numOf(raw, 'mid')
		item.owner.name = strOf(raw, 'author')
		const upic = strOf(raw, 'upic')
		item.owner.face = upic.startsWith('//') ? 'https:' + upic : upic
		item.stat.view = numOf(raw, 'play')
		item.stat.danmaku = numOf(raw, 'danmaku')
		item.stat.favorite = numOf(raw, 'favorite')
		item.stat.reply = numOf(raw, 'review')
		item.stat.like = numOf(raw, 'like')
		return item
	}
}

// ---------------------------------------------------------------- 用户

export class SearchUserItem {
	mid: number = 0
	uname: string = ''
	usign: string = ''
	fans: number = 0
	videos: number = 0
	upic: string = ''
	level: number = 0
	/** 官方认证说明（源 official_verify.desc；空串不渲染） */
	officialDesc: string = ''
	isLive: number = 0
	roomId: number = 0

	static from(raw: UTSJSONObject): SearchUserItem {
		const item = new SearchUserItem()
		item.mid = numOf(raw, 'mid')
		item.uname = strOf(raw, 'uname')
		item.usign = strOf(raw, 'usign')
		item.fans = numOf(raw, 'fans')
		item.videos = numOf(raw, 'videos')
		const upic = strOf(raw, 'upic')
		item.upic = upic.startsWith('//') ? 'https:' + upic : upic
		item.level = numOf(raw, 'level')
		const verify = objOf(raw, 'official_verify')
		if (verify != null) {
			item.officialDesc = strOf(verify, 'desc')
		}
		item.isLive = numOf(raw, 'is_live')
		item.roomId = numOf(raw, 'room_id')
		return item
	}
}

// ---------------------------------------------------------------- 直播间

/** 直播「xx人看过」对象（源 watched_show{num,text}；空对象兜底不显示） */
export class WatchedShow {
	num: number = 0
	text: string = ''
}

export class SearchLiveItem {
	uid: number = 0
	uname: string = ''
	uface: string = ''
	userCover: string = ''
	title: string = ''
	titleSegs: TitleSeg[] = []
	cover: string = ''
	online: number = 0
	roomid: number = 0
	/** 分区名（源 Em.regCate 去标签取文本） */
	cateName: string = ''
	liveTime: string = ''
	watchedShow: WatchedShow = new WatchedShow()

	static from(raw: UTSJSONObject): SearchLiveItem {
		const item = new SearchLiveItem()
		item.uid = numOf(raw, 'uid')
		item.uname = strOf(raw, 'uname')
		const uface = strOf(raw, 'uface')
		item.uface = uface.startsWith('//') ? 'https:' + uface : uface
		const userCover = strOf(raw, 'user_cover')
		item.userCover = userCover.startsWith('//') ? 'https:' + userCover : userCover
		item.titleSegs = parseTitleSegs(strOf(raw, 'title'))
		item.title = segsToPlain(item.titleSegs)
		const cover = strOf(raw, 'cover')
		item.cover = cover.startsWith('//') ? 'https:' + cover : cover
		item.online = numOf(raw, 'online')
		item.roomid = numOf(raw, 'roomid')
		// 源 regCate：`<标签>文本</标签>` 取最后一组标签内文本；无标签原样（去实体）
		const cate = strOf(raw, 'cate_name')
		if (cate.indexOf('<') >= 0) {
			item.cateName = segsToPlain(parseTitleSegs(cate))
		} else {
			item.cateName = decodeHtmlEntities(cate)
		}
		item.liveTime = strOf(raw, 'live_time')
		const watched = objOf(raw, 'watched_show')
		if (watched != null) {
			item.watchedShow.num = numOf(watched, 'num')
			item.watchedShow.text = strOf(watched, 'text')
		}
		return item
	}
}

// ---------------------------------------------------------------- 番剧 / 影视（media 结构共用）

export class SearchMBangumiItem {
	mediaId: number = 0
	title: string = ''
	titleSegs: TitleSeg[] = []
	orgTitle: string = ''
	/** 1 番剧 / 2 国创（源 badge 文案 ternary；影视 tab 由页面另行传标） */
	mediaType: number = 0
	cv: string = ''
	staff: string = ''
	seasonId: number = 0
	seasonTypeName: string = ''
	buttonText: string = ''
	isFollow: number = 0
	cover: string = ''
	areas: string = ''
	styles: string = ''
	/** 评分（media_score.score；0 = 未开分） */
	score: number = 0
	indexShow: string = ''
	pubtime: number = 0

	static from(raw: UTSJSONObject): SearchMBangumiItem {
		const item = new SearchMBangumiItem()
		item.mediaId = numOf(raw, 'media_id')
		item.titleSegs = parseTitleSegs(strOf(raw, 'title'))
		item.title = segsToPlain(item.titleSegs)
		item.orgTitle = strOf(raw, 'org_title')
		item.mediaType = numOf(raw, 'media_type')
		item.cv = strOf(raw, 'cv')
		item.staff = strOf(raw, 'staff')
		item.seasonId = numOf(raw, 'season_id')
		item.seasonTypeName = strOf(raw, 'season_type_name')
		item.buttonText = strOf(raw, 'button_text')
		item.isFollow = numOf(raw, 'is_follow')
		const cover = strOf(raw, 'cover')
		item.cover = cover.startsWith('//') ? 'https:' + cover : cover
		item.areas = strOf(raw, 'areas')
		item.styles = strOf(raw, 'styles')
		const scoreObj = objOf(raw, 'media_score')
		if (scoreObj != null) {
			item.score = numOf(scoreObj, 'score')
		}
		item.indexShow = strOf(raw, 'index_show')
		item.pubtime = numOf(raw, 'pubtime')
		return item
	}
}

// ---------------------------------------------------------------- 专栏

export class SearchArticleItem {
	id: number = 0
	mid: number = 0
	pubTime: number = 0
	like: number = 0
	titleSegs: TitleSeg[] = []
	/** 源 subTitle：title 去标签 + 实体解码 */
	subTitle: string = ''
	imageUrls: string[] = []
	view: number = 0
	reply: number = 0
	desc: string = ''
	categoryName: string = ''

	static from(raw: UTSJSONObject): SearchArticleItem {
		const item = new SearchArticleItem()
		item.id = numOf(raw, 'id')
		item.mid = numOf(raw, 'mid')
		item.pubTime = numOf(raw, 'pub_time')
		item.like = numOf(raw, 'like')
		item.titleSegs = parseTitleSegs(strOf(raw, 'title'))
		item.subTitle = segsToPlain(item.titleSegs)
		item.imageUrls = strArrayOf(raw, 'image_urls')
		item.view = numOf(raw, 'view')
		item.reply = numOf(raw, 'reply')
		item.desc = strOf(raw, 'desc')
		item.categoryName = strOf(raw, 'category_name')
		return item
	}
}
