import { strOf, numOf, objOf, arrOf, boolOf } from '../utils/json.uts'
import { toSecureUrl } from '../utils/url.uts'

/**
 * 用户主页域模型。源头：`lib/models/member/{info,archive,article,seasons,coin,like,tags}.dart`，
 * 以及 `lib/models/dynamics/result.dart`（本文件只提取最小动态卡所需字段子集，完整动态卡归 P6）。
 *
 * 字段名与源 JSON 键一致（snake_case 键在 from() 内映射），解析统一走 utils/json.uts 防御式取值。
 */

/** 大会员信息（源 Vip；nickname_color 为 "#RRGGBB" 字符串） */
export class MemberVip {
	type: number = 0
	status: number = 0
	label: string = ''
	labelStatic: string = ''
	nicknameColor: string = ''

	static from(obj: UTSJSONObject | null): MemberVip {
		const vip = new MemberVip()
		if (obj == null) {
			return vip
		}
		vip.type = numOf(obj, 'type')
		vip.status = numOf(obj, 'status')
		const label = objOf(obj, 'label')
		if (label != null) {
			vip.label = strOf(label, 'img_label_uri_hans')
			vip.labelStatic = strOf(label, 'img_label_uri_hans_static')
		}
		vip.nicknameColor = strOf(obj, 'nickname_color')
		return vip
	}
}

/** 直播间摘要（源 LiveRoom；liveStatus=1 时资料区显示「直播中」角标） */
export class MemberLiveRoom {
	roomStatus: number = 0
	liveStatus: number = 0
	roomId: number = 0
	title: string = ''
	cover: string = ''
	url: string = ''

	static from(obj: UTSJSONObject | null): MemberLiveRoom {
		const room = new MemberLiveRoom()
		if (obj == null) {
			return room
		}
		room.roomStatus = numOf(obj, 'roomStatus')
		room.liveStatus = numOf(obj, 'liveStatus')
		room.roomId = numOf(obj, 'roomid')
		room.title = strOf(obj, 'title')
		room.cover = strOf(obj, 'cover')
		room.url = strOf(obj, 'url')
		return room
	}
}

/** 用户资料（源 MemberInfoModel，/x/space/wbi/acc/info） */
export class MemberInfo {
	mid: number = 0
	name: string = ''
	sex: string = ''
	face: string = ''
	/** 源：sign 为空串时替换为「该用户还没有签名」，并去掉换行 */
	sign: string = ''
	level: number = 0
	isFollowed: boolean = false
	topPhoto: string = ''
	/** 认证角色：1 个人认证 / 2 企业认证（源按 role==1 判个人，否则企业） */
	officialRole: number = -1
	officialTitle: string = ''
	vip: MemberVip = new MemberVip()
	liveRoom: MemberLiveRoom | null = null

	static from(obj: UTSJSONObject | null): MemberInfo {
		const info = new MemberInfo()
		if (obj == null) {
			return info
		}
		info.mid = numOf(obj, 'mid')
		info.name = strOf(obj, 'name')
		info.sex = strOf(obj, 'sex')
		info.face = strOf(obj, 'face')
		const rawSign = strOf(obj, 'sign')
		info.sign = rawSign.length == 0 ? '该用户还没有签名' : rawSign.replace('\n', '')
		info.level = numOf(obj, 'level')
		info.isFollowed = boolOf(obj, 'is_followed')
		info.topPhoto = strOf(obj, 'top_photo')
		const official = objOf(obj, 'official')
		if (official != null) {
			info.officialRole = numOf(official, 'role')
			info.officialTitle = strOf(official, 'title')
		}
		info.vip = MemberVip.from(objOf(obj, 'vip'))
		const room = objOf(obj, 'live_room')
		info.liveRoom = room == null ? null : MemberLiveRoom.from(room)
		return info
	}
}

/** 投稿卡（源 VListItemModel，/x/space/wbi/arc/search 的 list.vlist[]） */
export class VListItem {
	comment: number = 0
	typeid: number = 0
	play: number = 0
	pic: string = ''
	title: string = ''
	author: string = ''
	mid: number = 0
	created: number = 0
	/** 源：length 为 "mm:ss" 字符串，duration 为其秒数换算结果 */
	length: string = ''
	duration: number = 0
	videoReview: number = 0
	aid: number = 0
	bvid: string = ''
	isChargingSrc: boolean = false

	static from(obj: UTSJSONObject): VListItem {
		const item = new VListItem()
		item.comment = numOf(obj, 'comment')
		item.typeid = numOf(obj, 'typeid')
		item.play = numOf(obj, 'play')
		item.pic = strOf(obj, 'pic')
		item.title = strOf(obj, 'title')
		item.author = strOf(obj, 'author')
		item.mid = numOf(obj, 'mid')
		item.created = numOf(obj, 'created')
		item.length = strOf(obj, 'length')
		item.videoReview = numOf(obj, 'video_review')
		item.aid = numOf(obj, 'aid')
		item.bvid = strOf(obj, 'bvid')
		item.isChargingSrc = boolOf(obj, 'is_charging_arc')
		return item
	}
}

