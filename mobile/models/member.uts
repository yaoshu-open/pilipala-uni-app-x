}

/** 合集/系列详情条目（源 MemberArchiveItem；seasons_archives_list 与 series archives 同构） */
export class MemberArchiveItem {
	aid: number = 0
	bvid: string = ''
	title: string = ''
	cover: string = ''
	ctime: number = 0
	pubdate: number = 0
	duration: number = 0
	view: number = 0

	static from(obj: UTSJSONObject): MemberArchiveItem {
		const item = new MemberArchiveItem()
		item.aid = numOf(obj, 'aid')
		item.bvid = strOf(obj, 'bvid')
		item.title = strOf(obj, 'title')
		item.cover = strOf(obj, 'pic')
		item.ctime = numOf(obj, 'ctime')
		item.pubdate = numOf(obj, 'pubdate')
		item.duration = numOf(obj, 'duration')
		const stat = objOf(obj, 'stat')
		item.view = stat == null ? 0 : numOf(stat, 'view')
		return item
	}
}

/** 主页合集面板条目（源 MemberSeasonsList：meta + 前 4 条视频，截断由调用方做） */
export class MemberSeasonsItem {
	meta: MemberSeasonMeta = new MemberSeasonMeta()
	archives: Array<MemberArchiveItem> = []

	static from(obj: UTSJSONObject): MemberSeasonsItem {
		const item = new MemberSeasonsItem()
		item.meta = MemberSeasonMeta.from(objOf(obj, 'meta'))
		const list = arrOf(obj, 'archives')
		for (let i = 0; i < list.length; i++) {
			item.archives.push(MemberArchiveItem.from(list[i]))
		}
		return item
	}
}

