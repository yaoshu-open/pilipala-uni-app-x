		if (obj == null) {
			return meta
		}
		meta.cover = strOf(obj, 'cover')
		meta.description = strOf(obj, 'description')
		meta.mid = numOf(obj, 'mid')
		meta.name = strOf(obj, 'name')
		meta.seasonId = numOf(obj, 'season_id')
		meta.seriesId = numOf(obj, 'series_id')
		meta.total = numOf(obj, 'total')
		meta.category = numOf(obj, 'category')
		return meta
