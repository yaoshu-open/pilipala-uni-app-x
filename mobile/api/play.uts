		return await fetchUserStatRaw(mid)
	} catch (e) {
		console.log('[play] fetchUserStat error mid=' + mid.toString())
		console.log(e)
		const failed = new UserStatResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

async function fetchDefaultFavFolderRaw(mid: number, rid: number): Promise<FavFolderResult> {
	const result = new FavFolderResult()
	const params = new Params()
	params.setNum('up_mid', mid)
	params.setNum('rid', rid)
	const res = await apiGet('/x/v3/fav/folder/created/list-all', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	const list = data == null ? [] : arrOf(data, 'list')
	if (list.length == 0) {
		result.message = '没有可用的收藏夹'
		return result
	}
	// 源 actionFavVideo(type=default)：取第一个收藏夹做快速收藏
	result.folderId = numOf(list[0], 'id')
	result.favState = numOf(list[0], 'fav_state')
	result.status = true
	return result
}

/** 取默认（第一个）收藏夹及该视频在其中的收藏态 */
export async function fetchDefaultFavFolder(mid: number, rid: number): Promise<FavFolderResult> {
	try {
		return await fetchDefaultFavFolderRaw(mid, rid)
	} catch (e) {
		console.log('[play] fetchDefaultFavFolder error aid=' + rid.toString())
		console.log(e)
		const failed = new FavFolderResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

/**
 * 快速收藏切换（源 actionFavVideo type='default'）：
 * 查默认收藏夹 → 未收藏则加入、已收藏则移出 → 重新确认收藏态。
 */
export async function toggleDefaultFav(aid: number): Promise<FavToggleResult> {
	const result = new FavToggleResult()
	try {
		if (!userState.isLogin) {
			result.message = '账号未登录'
			return result
		}
		const folder = await fetchDefaultFavFolder(userState.info.mid, aid)
		if (!folder.status || folder.folderId <= 0) {
			result.message = folder.message
			return result
		}
		const addIds = folder.favState == 0 ? folder.folderId.toString() : ''
		const delIds = folder.favState == 1 ? folder.folderId.toString() : ''
		const action = await favVideo(aid, addIds, delIds)
		if (!action.status) {
			result.message = action.message
			return result
		}
		const state = await hasFav(aid)
		if (state.status) {
			result.faved = state.value
		} else {
			result.faved = folder.favState == 0
		}
		result.status = true
		return result
	} catch (e) {
		console.log('[play] toggleDefaultFav error aid=' + aid.toString())
		console.log(e)
		result.message = '数据解析异常，请稍后重试'
		return result
	}
}

async function addWatchLaterRaw(bvid: string): Promise<ActionResult> {
	const params = new Params()
	params.set('bvid', bvid)
	return await postWithCsrf('/x/v2/history/toview/add', params)
}

/** 稍后再看（源 UserHttp.toViewLater） */
export async function addWatchLater(bvid: string): Promise<ActionResult> {
	try {
		return await addWatchLaterRaw(bvid)
	} catch (e) {
		console.log('[play] addWatchLater error bvid=' + bvid)
		console.log(e)
		const failed = new ActionResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}
