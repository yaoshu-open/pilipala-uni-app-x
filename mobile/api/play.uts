	}
}

// ---------------------------------------------------------------- 相关推荐

async function fetchRelatedRaw(bvid: string): Promise<ListResult<HotVideoItem>> {
	const result = new ListResult<HotVideoItem>()
	const params = new Params()
	params.set('bvid', bvid)
	const res = await apiGet('/x/web-interface/archive/related', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		return result
	}
	const list = arrOf(res, 'data')
	for (let i = 0; i < list.length; i++) {
		const raw = list[i]
		const ownerObj = objOf(raw, 'owner')
		if (ownerObj != null && isBlockedMid(numOf(ownerObj, 'mid'))) {
			continue
		}
		const item = HotVideoItem.from(raw)
		// 相关推荐走 P3 同一条过滤链；条目无 isFollowed 字段，按非关注视频传 0
		if (!shouldFilterVideo(item.duration, item.stat.view, item.stat.like, 0, true)) {
			result.items.push(item)
		}
	}
	result.status = true
	return result
}

/** 相关推荐（复用 P3 过滤链：拉黑 UP + 时长/点赞比阈值） */
export async function fetchRelated(bvid: string): Promise<ListResult<HotVideoItem>> {
	try {
		return await fetchRelatedRaw(bvid)
	} catch (e) {
		console.log('[play] fetchRelated error bvid=' + bvid)
		console.log(e)
		const failed = new ListResult<HotVideoItem>()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

// ---------------------------------------------------------------- 同时在看

async function fetchOnlineTotalRaw(aid: number, bvid: string, cid: number): Promise<OnlineResult> {
	const result = new OnlineResult()
	const params = new Params()
	params.setNum('aid', aid)
	params.set('bvid', bvid)
	params.setNum('cid', cid)
	const res = await apiGet('/x/player/online/total', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.status = true
		return result
	}
	const total = strOf(data, 'total')
	result.total = total.length > 0 ? total : numOf(data, 'total').toString()
	result.status = true
	return result
}

/** 同时在看人数（源 10s 轮询，仅详情页可见时） */
export async function fetchOnlineTotal(aid: number, bvid: string, cid: number): Promise<OnlineResult> {
	try {
		return await fetchOnlineTotalRaw(aid, bvid, cid)
	} catch (e) {
		console.log('[play] fetchOnlineTotal error bvid=' + bvid)
		console.log(e)
		const failed = new OnlineResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

