} from '../models/video-detail.uts'

/**
 * 视频详情域接口层（源头：`lib/http/video.dart` + `lib/http/user.dart` 的相关条目）。
 *
 * 约定与 P3 `api/video.uts` 一致：
 *  - 内部 `xxxRaw` 负责请求 + 解析，导出函数统一 try/catch 兜底，**解析异常落失败结果并打日志**，
 *    绝不让异常穿透到页面（P3 曾因 ReferenceError 穿透导致列表恒停在骨架）；
 *  - 失败不伪装成空：message 优先取接口 message，其次网络/解析文案。
 *
 * 写操作（点赞/投币/收藏/关注/稍后再看）统一走 `postWithCsrf`：csrf 取不到时明确失败，
 * 不静默当成成功（取数限制见 utils/request.uts#getCsrf）。
 */

function codeOf(res: UTSJSONObject): number {
	const code = res.getNumber('code')
	return code == null ? -1 : code
}

function messageOf(res: UTSJSONObject): string {
	const message = res.getString('message')
	if (message == null || message.length == 0) {
		return '请求异常'
	}
	return message
}

/** 带 csrf 的写请求（csrf 由请求层从 cookie 镜像取） */
async function postWithCsrf(path: string, params: Params): Promise<ActionResult> {
	const result = new ActionResult()
	const csrf = getCsrf()
	if (csrf.length == 0) {
		result.message = '登录凭据缺失，请重新登录后再试'
		console.log('[play] csrf empty path=' + path)
		return result
	}
	const body = params.clone()
	body.set('csrf', csrf)
	const res = await apiPost(path, body.toObject())
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = messageOf(res)
		console.log('[play] post fail path=' + path + ' code=' + result.code.toString())
		return result
	}
	result.status = true
	return result
}

// ---------------------------------------------------------------- 播放地址

/**
 * CDN 优选（源头：lib/utils/video_utils.dart getCdnUrl，控制键 SK.enableCDN）：
 *  - mcdn 节点（PCDN，非标准端口）改走官方代理中转；
 *  - upgcxcode 主地址把域名换成阿里云镜像源（源同款 cdnList.ali）。
 * 关闭 CDN 优化时不调用本函数，直接用接口返回的 backup_url / base_url（源同款）。
 */
export function optimizeCdnUrl(url: string): string {
	if (url.length == 0) {
		return url
	}
	if (url.indexOf('.mcdn.bilivideo') >= 0) {
		return 'https://proxy-tf-all-ws.bilivideo.com/?url=' + encodeURIComponent(url)
	}
	if (url.indexOf('/upgcxcode/') >= 0) {
		const marker = url.indexOf('/upgcxcode/')
		const schemeEnd = url.indexOf('://')
		if (schemeEnd < 0) {
			return url
		}
		const rest = url.substring(schemeEnd + 3)
		const slash = rest.indexOf('/')
		if (slash < 0) {
			return url
		}
		return 'https://upos-sz-mirrorali.bilivideo.com' + url.substring(schemeEnd + 3 + slash)
	}
	return url
}

/**
 * 起播地址选择（详情页与全屏页**共用同一口径**，源头 lib/pages/video/detail/controller.dart）：
 *  - SK.enableCDN 开：优先接口给的 backup_url，并对 mcdn/upgcxcode 做主域名优选；
 *  - 关：backup_url 优先，原样使用（不做域名替换）。
 * 两处各自实现过一次，结果全屏页拿到未优选的主地址直接 `Source error`（真机实测 code=300001）。
 */
export function selectPlaySrc(primary: string, backup: string): string {
	if (getBool(SK.enableCDN, true)) {
		const preferred = backup.length > 0 ? backup : primary
		return optimizeCdnUrl(preferred)
	}
	return backup.length > 0 ? backup : primary
}

/** 起播主地址之外的备用地址（无备用或未开 CDN 优化时为空串） */
export function selectPlayBackup(primary: string, backup: string): string {
	if (!getBool(SK.enableCDN, true)) {
		return ''
	}
	const preferred = backup.length > 0 ? backup : primary
	return preferred == primary ? '' : primary
}

async function fetchPlayUrlRaw(bvid: string, cid: number, useDash: boolean): Promise<PlayResult> {
	const result = new PlayResult()
	const params = new Params()
	params.setNum('cid', cid)
	// 画质初始档：源取设置项 defaultVideoQa（默认 1080P60；durl 兜底链下服务端按 accept_quality 回档）
	params.setNum('qn', getNumber(SK.defaultVideoQa, 116))
	// fnval=1 取 durl 单文件流（本期 A 后端）；4048 为 DASH 分离轨，留给 pl-player（B 后端）
	params.setNum('fnval', useDash ? 4048 : 1)
	params.set('bvid', bvid)
	params.setNum('fourk', 1)
	params.setNum('voice_balance', 1)
	params.set('gaia_source', 'pre-load')
	params.setNum('web_location', 1550101)
	// 未登录时试看 1080P（源 videoUrl 同款）
	if (!userState.isLogin && getBool(SK.p1080, true)) {
		params.setNum('try_look', 1)
	}
	const res = await wbiGet('/x/player/wbi/playurl', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = messageOf(res)
		console.log('[play] playurl code=' + result.code.toString() + ' cid=' + cid.toString())
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.message = '数据解析异常，请稍后重试'
		console.log('[play] playurl data null cid=' + cid.toString())
		return result
	}
	const play = new PlayData()
	play.quality = numOf(data, 'quality')
	play.timeLength = numOf(data, 'timelength')
	play.lastPlayTime = numOf(data, 'last_play_time')
	play.lastPlayCid = numOf(data, 'last_play_cid')
	play.acceptQuality = numArrayOf(data, 'accept_quality')
	play.acceptDesc = strArrayOf(data, 'accept_description')
	const durlList = arrOf(data, 'durl')
	for (let i = 0; i < durlList.length; i++) {
		play.durl.push(DurlItem.from(durlList[i]))
	}
	const dash = objOf(data, 'dash')
	if (dash != null) {
		play.dashDuration = numOf(dash, 'duration')
		const videos = arrOf(dash, 'video')
		if (videos.length > 0) {
			play.dashVideoUrl = strOf(videos[0], 'baseUrl')
		}
		const audios = arrOf(dash, 'audio')
		if (audios.length > 0) {
			play.dashAudioUrl = strOf(audios[0], 'baseUrl')
		}
	}
	result.status = true
	result.data = play
	console.log('[play] playurl ok cid=' + cid.toString() + ' quality=' + play.quality.toString() +
		' durl=' + play.durl.length.toString() + ' last=' + play.lastPlayTime.toString() +
		' dash=' + (play.dashVideoUrl.length > 0 ? 'yes' : 'no'))
	return result
}

/** 取播放地址；useDash=false → fnval=1（durl 单文件流），true → fnval=4048（DASH，预留） */
export async function fetchPlayUrl(bvid: string, cid: number, useDash: boolean): Promise<PlayResult> {
	try {
		return await fetchPlayUrlRaw(bvid, cid, useDash)
	} catch (e) {
		console.log('[play] fetchPlayUrl error bvid=' + bvid)
		console.log(e)
		const failed = new PlayResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

