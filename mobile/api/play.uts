async function oneThreeRaw(bvid: string): Promise<TripleResult> {
	const result = new TripleResult()
	const csrf = getCsrf()
	if (csrf.length == 0) {
		result.message = '登录凭据缺失，请重新登录后再试'
		return result
	}
	const params = new Params()
	params.set('bvid', bvid)
	params.set('csrf', csrf)
	const res = await apiPost('/x/web-interface/archive/like/triple', params.toObject())
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	if (data != null) {
		result.like = boolOf(data, 'like')
		result.coin = boolOf(data, 'coin')
		result.fav = boolOf(data, 'fav')
	}
	result.status = true
	return result
}

