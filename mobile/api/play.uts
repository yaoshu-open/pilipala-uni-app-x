	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		return result
	}
	// 源口径：data 为被点赞标志 0/1
	result.value = numOf(res, 'data') == 1
	result.status = true
	return result
}

