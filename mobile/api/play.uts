async function fetchVideoDetailRaw(bvid: string): Promise<DetailResult> {
	const result = new DetailResult()
	const params = new Params()
	params.set('bvid', bvid)
	const res = await apiGet('/x/web-interface/view', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = messageOf(res)
		console.log('[play] view code=' + result.code.toString() + ' bvid=' + bvid)
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.message = '数据解析异常，请稍后重试'
		console.log('[play] view data null bvid=' + bvid)
		return result
	}
	result.data = VideoDetail.from(data)
	result.status = true
	const detail = result.data
	if (detail != null) {
		console.log('[play] view ok bvid=' + bvid + ' pages=' + detail.pages.length.toString() +
			' season=' + (detail.ugcSeason == null ? 'no' : 'yes'))
	}
	return result
}

