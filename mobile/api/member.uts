		const failed = new RelationStatResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

async function fetchMemberUpstatRaw(mid: number): Promise<MemberUpstatResult> {
	const result = new MemberUpstatResult()
	const params = new Params()
	params.setNum('mid', mid)
	const res = await apiGet('/x/space/upstat', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	if (codeOf(res) != 0) {
		// 该接口需登录 cookie；未登录失败是预期形态，页面按 '-' 展示（源 userStat['likes'] == null 同款）
		result.message = messageOf(res)
		console.log('[member] upstat code=' + codeOf(res).toString() + ' mid=' + mid.toString())
		return result
	}
	const data = objOf(res, 'data')
	if (data != null) {
		result.likes = numOf(data, 'likes')
	}
	result.status = true
	return result
}

/** 获赞数（读-登录态；失败不阻塞页面，仅获赞列显示 '-'） */
