async function fetchSeasonDetailRaw(mid: number, seasonId: number, pn: number): Promise<SeasonDetailResult> {
	const result = new SeasonDetailResult()
	const params = new Params()
	params.setNum('mid', mid)
	params.setNum('season_id', seasonId)
	params.set('sort_reverse', 'false')
	params.setNum('page_num', pn)
	params.setNum('page_size', 30)
	const res = await apiGet('/x/polymer/web-space/seasons_archives_list', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	if (codeOf(res) != 0) {
		result.message = messageOf(res)
		console.log('[member] season-detail code=' + codeOf(res).toString() + ' seasonId=' + seasonId.toString())
		return result
	}
	const data = objOf(res, 'data')
	if (data != null) {
		const archives = arrOf(data, 'archives')
		for (let i = 0; i < archives.length; i++) {
			result.items.push(MemberArchiveItem.from(archives[i]))
		}
		const page = objOf(data, 'page')
		if (page != null) {
			result.total = numOf(page, 'total')
		}
	}
	result.status = true
	return result
}

