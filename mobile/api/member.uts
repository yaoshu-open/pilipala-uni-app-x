// ---------------------------------------------------------------- 投稿（arc/search）

async function fetchMemberArchiveRaw(mid: number, pn: number, order: string, keyword: string): Promise<MemberArchiveResult> {
	const result = new MemberArchiveResult()
	const params = new Params()
	params.setNum('mid', mid)
	params.setNum('ps', 30)
	params.setNum('tid', 0)
	params.setNum('pn', pn)
	params.set('keyword', keyword)
	params.set('platform', 'web')
	params.set('web_location', '1550101')
	params.set('order_avoided', 'true')
	params.set('dm_img_list', '[]')
	params.set('dm_img_str', randomImgStr(64))
	params.set('dm_cover_img_str', randomImgStr(128))
	params.set('dm_img_inter', '{"ds":[],"wh":[0,0,0],"of":[0,0,0]}')
	// 源同款：充电专属 = pubdate 排序 + special_type=charging
	if (order == 'charge') {
		params.set('order', 'pubdate')
		params.set('special_type', 'charging')
	} else {
		params.set('order', order)
	}
	const res = await wbiGet('/x/space/wbi/arc/search', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = riskControlMessage(result.code, messageOf(res))
		console.log('[member] archive code=' + result.code.toString() + ' mid=' + mid.toString() + ' pn=' + pn.toString())
		return result
	}
	const data = objOf(res, 'data')
	if (data != null) {
		const list = objOf(data, 'list')
		if (list != null) {
			const vlist = arrOf(list, 'vlist')
			for (let i = 0; i < vlist.length; i++) {
				result.items.push(VListItem.from(vlist[i]))
			}
		}
		const page = objOf(data, 'page')
		if (page != null) {
			result.count = numOf(page, 'count')
		}
	}
	result.status = true
	return result
}

/** 投稿列表（member-archive 页与 member-search 投稿搜索共用；order：pubdate/click/stow/charge） */
export async function fetchMemberArchive(mid: number, pn: number, order: string, keyword: string): Promise<MemberArchiveResult> {
	try {
		return await fetchMemberArchiveRaw(mid, pn, order, keyword)
	} catch (e) {
		console.log('[member] fetchMemberArchive error mid=' + mid.toString() + ' pn=' + pn.toString())
		console.log(e)
		const failed = new MemberArchiveResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

// ---------------------------------------------------------------- 空间动态（feed/space）

async function fetchMemberDynamicRaw(mid: number, offset: string): Promise<DynamicFeedResult> {
	const result = new DynamicFeedResult()
	const params = new Params()
	params.set('offset', offset)
	params.setNum('host_mid', mid)
	params.set('timezone_offset', '-480')
	params.set('features', 'itemOpusStyle')
	const res = await apiGet('/x/polymer/web-dynamic/v1/feed/space', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = riskControlMessage(result.code, messageOf(res))
		console.log('[member] dynamic code=' + result.code.toString() + ' mid=' + mid.toString())
		return result
	}
	const data = objOf(res, 'data')
	if (data != null) {
		result.offset = strOf(data, 'offset')
		result.hasMore = data.getBoolean('has_more') == true
		const items = arrOf(data, 'items')
		for (let i = 0; i < items.length; i++) {
			result.items.push(DynamicItem.from(items[i]))
		}
	}
	result.status = true
	return result
}

/** 某用户动态流（offset 分页；源：offset 空串起步、返回空串置 '-1' 终止） */
export async function fetchMemberDynamic(mid: number, offset: string): Promise<DynamicFeedResult> {
	try {
		return await fetchMemberDynamicRaw(mid, offset)
	} catch (e) {
		console.log('[member] fetchMemberDynamic error mid=' + mid.toString())
		console.log(e)
		const failed = new DynamicFeedResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

// ---------------------------------------------------------------- 主页合集面板

async function fetchMemberSeasonsRaw(mid: number): Promise<MemberSeasonsResult> {
	const result = new MemberSeasonsResult()
	const params = new Params()
	params.setNum('mid', mid)
	params.setNum('page_num', 1)
	params.setNum('page_size', 10)
	const res = await apiGet('/x/polymer/web-space/home/seasons_series', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	if (codeOf(res) != 0) {
		result.message = messageOf(res)
		console.log('[member] seasons code=' + codeOf(res).toString() + ' mid=' + mid.toString())
		return result
	}
	const data = objOf(res, 'data')
	const lists = data == null ? null : objOf(data, 'items_lists')
	if (lists != null) {
		// 源同款：seasons_list 与 series_list 拼接成一个面板列表
		const seasons = arrOf(lists, 'seasons_list')
		for (let i = 0; i < seasons.length; i++) {
			result.items.push(MemberSeasonsItem.from(seasons[i]))
		}
		const series = arrOf(lists, 'series_list')
		for (let i = 0; i < series.length; i++) {
			result.items.push(MemberSeasonsItem.from(series[i]))
		}
	}
	result.status = true
	return result
}

/** 主页合集面板（seasons+series 拼接；页面侧截取前 4 条视频） */
export async function fetchMemberSeasons(mid: number): Promise<MemberSeasonsResult> {
	try {
		return await fetchMemberSeasonsRaw(mid)
	} catch (e) {
		console.log('[member] fetchMemberSeasons error mid=' + mid.toString())
		console.log(e)
		const failed = new MemberSeasonsResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

// ---------------------------------------------------------------- 最近投币 / 最近点赞

async function fetchRecentCoinVideoRaw(mid: number): Promise<MemberListResult<MemberCoinsItem>> {
	const result = new MemberListResult<MemberCoinsItem>()
	const params = new Params()
	params.setNum('mid', mid)
	params.set('gaia_source', 'main_web')
	params.set('web_location', '333.999')
	const res = await wbiGet('/x/space/coin/video', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	if (codeOf(res) != 0) {
		result.message = messageOf(res)
		console.log('[member] coin code=' + codeOf(res).toString() + ' mid=' + mid.toString())
		return result
	}
	const data = objOf(res, 'data')
	// coin 接口 data 为裸数组（源 res.data['data'].map 直接遍历）；objOf 只认对象，先走数组分支
	const rawArray = res.getArray('data')
	if (rawArray != null) {
		for (let i = 0; i < rawArray.length; i++) {
			const item = rawArray[i]
			if (item != null) {
				result.items.push(MemberCoinsItem.from(item as UTSJSONObject))
			}
		}
	} else if (data != null) {
		const list = arrOf(data, 'list')
		for (let i = 0; i < list.length; i++) {
			result.items.push(MemberCoinsItem.from(list[i]))
		}
	}
	result.status = true
	return result
}

/** 最近投币视频（读-登录态；未登录页面不请求） */
export async function fetchRecentCoinVideo(mid: number): Promise<MemberListResult<MemberCoinsItem>> {
