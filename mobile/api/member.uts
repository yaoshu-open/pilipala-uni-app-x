import { apiGet } from '../utils/request.uts'
import { wbiGet } from '../utils/wbi.uts'
import { Params } from '../utils/params.uts'
import { strOf, numOf, objOf, arrOf } from '../utils/json.uts'
import { REFERER, UA_MOBILE, REQUEST_TIMEOUT } from '../utils/constants.uts'
import {
	MemberInfo, VListItem, MemberArchiveItem, MemberSeasonsItem, MemberCoinsItem, MemberLikeItem,
	MemberArticleItem, DynamicItem,
	MemberInfoResult, RelationStatResult, MemberUpstatResult, RelationResult, MemberArchiveResult,
	DynamicFeedResult, MemberSeasonsResult, SeasonDetailResult, WWebidResult, MemberArticleResult,
	MemberListResult
} from '../models/member.uts'

/**
 * 用户主页域接口层（源头：`lib/http/member.dart` + `lib/http/video.dart#relationMod`）。
 *
 * 约定与 P3/P4 其它 api 文件一致：
 *  - 内部 `xxxRaw` 负责请求 + 解析，导出函数统一 try/catch 兜底，**解析异常落失败结果并打日志**，
 *    绝不让异常穿透到页面；失败不伪装成空（message 优先取接口 message）。
 *  - 写操作（关注/取关/拉黑）不在本文件：与视频详情页共用 `api/play.uts#followMod`
 *    （同一端点 /x/relation/modify，已含 getCsrf 前置校验与 act 泛化）。
 *  - 投稿接口 -352 映射「风控校验失败，请检查登录状态」（源同款 errMap）。
 */

function codeOf(res: UTSJSONObject): number {
	const code = res.getNumber('code')
	return code == null ? -1 : code
}

function messageOf(res: UTSJSONObject): string {
	const message = res.getString('message')
	if (message == null || message.length == 0) {
		return '请求异常'
	}
	return message
}

/** 投稿/动态接口的错误码文案（源 memberArchive / memberDynamic 的 errMap） */
function riskControlMessage(code: number, fallback: string): string {
	if (code == -352) {
		return '风控校验失败，请检查登录状态'
	}
	return fallback
}

/** 源 Utils.base64EncodeRandomString(len, 64)：风控装饰字段，服务器只校验存在性 */
function randomImgStr(len: number): string {
	const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
	let out = ''
	for (let i = 0; i < len; i++) {
		const idx = Math.floor(Math.random() * chars.length)
		out = out + chars.substring(idx, idx + 1)
	}
	// 源 substring(0, len-2)：等价去掉 base64 尾部 padding 的两位
	return out.substring(0, len - 2)
}

// ---------------------------------------------------------------- 用户资料与统计

async function fetchMemberInfoRaw(mid: number): Promise<MemberInfoResult> {
	const result = new MemberInfoResult()
	const params = new Params()
	params.setNum('mid', mid)
	params.set('token', '')
	params.set('platform', 'web')
	params.set('web_location', '1550101')
	const res = await wbiGet('/x/space/wbi/acc/info', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		console.log('[member] info code=' + code.toString() + ' mid=' + mid.toString())
		return result
	}
	result.info = MemberInfo.from(objOf(res, 'data'))
	result.status = true
	return result
}

/** 用户资料（WBI 签名） */
export async function fetchMemberInfo(mid: number): Promise<MemberInfoResult> {
	try {
		return await fetchMemberInfoRaw(mid)
	} catch (e) {
		console.log('[member] fetchMemberInfo error mid=' + mid.toString())
		console.log(e)
		const failed = new MemberInfoResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

async function fetchRelationStatRaw(mid: number): Promise<RelationStatResult> {
	const result = new RelationStatResult()
	const params = new Params()
	params.setNum('vmid', mid)
	const res = await apiGet('/x/relation/stat', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	if (codeOf(res) != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	if (data != null) {
		result.following = numOf(data, 'following')
		result.follower = numOf(data, 'follower')
	}
	result.status = true
	return result
}

/** 关注数/粉丝数 */
export async function fetchRelationStat(mid: number): Promise<RelationStatResult> {
	try {
