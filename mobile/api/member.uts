// ---------------------------------------------------------------- 图文专栏（w_webid 前置 + opus feed）

/**
 * 抓 space.bilibili.com/{mid}/article 页面 HTML，取 <script id="__RENDER_DATA__"> 的
 * URL 编码 JSON，解出 access_id 作 w_webid（源 MemberHttp.getWWebid）。
 *
 * 走裸 uni.request 取文本（utils/request.uts 的 rawGet 只回 JSON 对象，HTML 会被
 * JSON.parse 判失败返回 null，拿不到正文）；失败返回 status=false，调用方 fallback '-1'。
 */
function fetchWWebidRaw(mid: number): Promise<WWebidResult> {
	return new Promise<WWebidResult>((resolve) => {
		const result = new WWebidResult()
		const url = 'https://space.bilibili.com/' + mid.toString() + '/article'
		const header: UTSJSONObject = {}
		header.set('referer', REFERER)
		header.set('user-agent', UA_MOBILE)
		uni.request({
			url: url,
			method: 'GET',
			header: header,
			timeout: REQUEST_TIMEOUT,
			success: (res) => {
				const html = res.data == null ? '' : (res.data as string)
				const marker = '<script id="__RENDER_DATA__" type="application/json">'
				const start = html.indexOf(marker)
				if (start < 0) {
					result.message = '请检查登录状态'
					console.log('[member] wwebid marker missing mid=' + mid.toString() + ' status=' + res.statusCode.toString())
					resolve(result)
					return
				}
				const bodyStart = start + marker.length
				const bodyEnd = html.indexOf('</script>', bodyStart)
				if (bodyEnd < 0) {
					result.message = '请检查登录状态'
					resolve(result)
					return
				}
				try {
					const decoded = decodeURIComponent(html.substring(bodyStart, bodyEnd))
					const map = JSON.parse<UTSJSONObject>(decoded)
					if (map == null) {
						result.message = '请检查登录状态'
						resolve(result)
						return
					}
					const accessId = map.getString('access_id')
					if (accessId == null || accessId.length == 0) {
						result.message = '请检查登录状态'
						resolve(result)
						return
					}
					result.webid = accessId
					result.status = true
					resolve(result)
				} catch (e) {
					result.message = '请检查登录状态'
					console.log('[member] wwebid parse error mid=' + mid.toString())
					console.log(e)
					resolve(result)
				}
			},
			fail: (err) => {
				result.message = '网络异常，请稍后重试'
				console.log('[member] wwebid request fail mid=' + mid.toString() + ' err=' + JSON.stringify(err))
				resolve(result)
			}
		})
	})
}

/** w_webid 前置（失败时页面 fallback '-1' + toast，源 controller.getWWebid 同款） */
export async function fetchWWebid(mid: number): Promise<WWebidResult> {
	try {
		return await fetchWWebidRaw(mid)
	} catch (e) {
		console.log('[member] fetchWWebid error mid=' + mid.toString())
		console.log(e)
		const failed = new WWebidResult()
		failed.message = '请检查登录状态'
		return failed
	}
}

async function fetchMemberArticleRaw(mid: number, page: number, offset: string, wWebid: string): Promise<MemberArticleResult> {
	const result = new MemberArticleResult()
	const params = new Params()
	params.setNum('host_mid', mid)
	params.setNum('page', page)
	params.set('offset', offset)
	params.set('web_location', '333.999')
	params.set('w_webid', wWebid)
	const res = await wbiGet('/x/polymer/web-dynamic/v1/opus/feed/space', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		console.log('[member] article code=' + code.toString() + ' mid=' + mid.toString() + ' page=' + page.toString())
		return result
	}
	const data = objOf(res, 'data')
	if (data != null) {
		result.offset = strOf(data, 'offset')
		result.hasMore = data.getBoolean('has_more') == true
		const items = arrOf(data, 'items')
		for (let i = 0; i < items.length; i++) {
			result.items.push(MemberArticleItem.from(items[i]))
		}
	}
	result.status = true
	return result
}

/** 图文专栏列表（page + offset 双游标；w_webid 由 fetchWWebid 前置取得） */
export async function fetchMemberArticle(mid: number, page: number, offset: string, wWebid: string): Promise<MemberArticleResult> {
	try {
		return await fetchMemberArticleRaw(mid, page, offset, wWebid)
	} catch (e) {
		console.log('[member] fetchMemberArticle error mid=' + mid.toString())
		console.log(e)
		const failed = new MemberArticleResult()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}
