		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

// ---------------------------------------------------------------- 写：关系操作

/**
 * 关系操作（源 Api.relationMod = /x/relation/modify）。
 * act：1 关注 / 2 取关 / 5 拉黑 / 6 解除拉黑；re_src 源码取值：关注链 11、移除黑名单 116。
 * csrf 取不到 → 明确失败（不发自请求）；未登录 code=-101 透传给页面。
 */
async function relationModifyRaw(fid: number, act: number, reSrc: number): Promise<ActionResult> {
	const result = new ActionResult()
	const csrf = getCsrf()
	if (csrf.length == 0) {
		result.message = '登录凭据缺失，请重新登录后再试'
		console.log('[relation] csrf empty act=' + act.toString())
		return result
	}
	const body = new Params()
	body.setNum('fid', fid)
	body.setNum('act', act)
	body.setNum('re_src', reSrc)
	body.set('jsonp', 'jsonp')
	body.set('csrf', csrf)
	const res = await apiPost('/x/relation/modify', body.toObject())
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = messageOf(res)
		console.log('[relation] modify fail act=' + act.toString() + ' code=' + result.code.toString())
		return result
	}
	result.status = true
	return result
}

/** 取消关注（act=2） */
export async function unfollowUser(fid: number): Promise<ActionResult> {
	try {
		return await relationModifyRaw(fid, 2, 11)
	} catch (e) {
		console.log('[relation] unfollowUser error fid=' + fid.toString())
		console.log(e)
		const failed = new ActionResult()
		failed.message = '网络异常，请稍后重试'
		return failed
	}
}

/** 移出黑名单（act=6，源 BlackHttp.removeBlack 同参数集） */
export async function removeBlack(fid: number): Promise<ActionResult> {
	try {
		return await relationModifyRaw(fid, 6, 116)
	} catch (e) {
		console.log('[relation] removeBlack error fid=' + fid.toString())
		console.log(e)
		const failed = new ActionResult()
		failed.message = '网络异常，请稍后重试'
		return failed
	}
}
