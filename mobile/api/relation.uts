import { apiGet, apiPost, getCsrf } from '../utils/request.uts'
import { wbiGet } from '../utils/wbi.uts'
import { Params } from '../utils/params.uts'
import { arrOf, objOf } from '../utils/json.uts'
import { FollowItem, FansItem, BlackItem, RelationTag, PageResult, TagPageResult } from '../models/relation.uts'
import { ActionResult } from '../models/video-detail.uts'

/**
 * 关系域接口层（源头：lib/http/follow.dart、lib/http/black.dart、
 * lib/http/member.dart 的 followUpTags/followUpGroup/getfollowSearch）。
 *
 * 约定与 api/video.uts 一致：内部 `xxxRaw` 请求+解析，导出函数 try/catch 兜底，
 * 解析异常落失败结果（message=数据解析异常），绝不让异常穿透到页面。
 *
 * 写操作（取关/移除黑名单）统一前置 csrf 校验：getCsrf() 为空时明确失败
 * （toast 文案「登录凭据缺失，请重新登录后再试」由页面透传），不发无凭据请求、不假成功。
 */

function codeOf(res: UTSJSONObject): number {
	const code = res.getNumber('code')
	return code == null ? -1 : code
}

function messageOf(res: UTSJSONObject): string {
	const message = res.getString('message')
	if (message == null || message.length == 0) {
		return '请求异常'
	}
	return message
}

/** 未登录错误码（页面据此把重试按钮改为「去登录」） */
export const RELATION_CODE_NOT_LOGIN: number = -101

// ---------------------------------------------------------------- 读：关注列表

/** 全部关注（源 FollowHttp.followings：他人形态与回退单列表共用） */
async function fetchFollowingsRaw(vmid: number, pn: number, ps: number): Promise<PageResult<FollowItem>> {
	const result = new PageResult<FollowItem>()
	const params = new Params()
	params.setNum('vmid', vmid)
	params.setNum('pn', pn)
	params.setNum('ps', ps)
	params.set('order', 'desc')
	params.set('order_type', 'attention')
	const res = await apiGet('/x/relation/followings', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.message = '请求异常'
		return result
	}
	result.total = numOfStrict(data, 'total')
	const list = arrOf(data, 'list')
	for (let i = 0; i < list.length; i++) {
		result.items.push(FollowItem.from(list[i]))
	}
	result.status = true
	return result
}

function numOfStrict(obj: UTSJSONObject, key: string): number {
	const value = obj.getNumber(key)
	return value == null ? 0 : value
}

export async function fetchFollowings(vmid: number, pn: number, ps: number): Promise<PageResult<FollowItem>> {
	try {
		return await fetchFollowingsRaw(vmid, pn, ps)
	} catch (e) {
		console.log('[relation] fetchFollowings error vmid=' + vmid.toString())
		console.log(e)
		const failed = new PageResult<FollowItem>()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

