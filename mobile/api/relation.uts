/** 某分组下的关注（源 MemberHttp.followUpGroup：/x/relation/tag） */
async function fetchFollowGroupRaw(mid: number, tagid: number, pn: number, ps: number): Promise<TagPageResult<FollowItem>> {
	const result = new TagPageResult<FollowItem>()
	const params = new Params()
	params.setNum('mid', mid)
	params.setNum('tagid', tagid)
	params.setNum('pn', pn)
	params.setNum('ps', ps)
	const res = await apiGet('/x/relation/tag', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		return result
	}
	// 实测 B 站 /x/relation/tag 响应：data 直接是用户对象数组（空分组为 []），无 {list} 包装
	// （旧源 MemberHttp.followUpGroup 同形态）；空数组走「成功 0 条」→ 页面空态「没有数据」
	const rawArr = res.getArray('data')
	if (rawArr != null) {
		for (let i = 0; i < rawArr.length; i++) {
			const item = rawArr[i]
			if (item != null) {
				result.items.push(FollowItem.from(item as UTSJSONObject))
			}
		}
		result.status = true
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.message = '请求异常'
		return result
	}
	const list = arrOf(data, 'list')
	for (let i = 0; i < list.length; i++) {
		result.items.push(FollowItem.from(list[i]))
	}
	result.status = true
	return result
}

export async function fetchFollowGroup(mid: number, tagid: number, pn: number, ps: number): Promise<TagPageResult<FollowItem>> {
	try {
		return await fetchFollowGroupRaw(mid, tagid, pn, ps)
	} catch (e) {
		console.log('[relation] fetchFollowGroup error tagid=' + tagid.toString())
		console.log(e)
		const failed = new TagPageResult<FollowItem>()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

