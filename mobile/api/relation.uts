	params.setNum('ps', ps)
	params.set('order', 'desc')
	params.set('order_type', 'attention')
	params.set('gaia_source', 'main_web')
	params.set('name', name)
	params.setNum('web_location', 333.999)
	const res = await wbiGet('/x/relation/followings/search', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.message = '请求异常'
		return result
	}
	result.total = numOfStrict(data, 'total')
	const list = arrOf(data, 'list')
	for (let i = 0; i < list.length; i++) {
		result.items.push(FollowItem.from(list[i]))
	}
	result.status = true
	return result
}

export async function fetchFollowSearch(vmid: number, name: string, pn: number, ps: number): Promise<PageResult<FollowItem>> {
	try {
		return await fetchFollowSearchRaw(vmid, name, pn, ps)
	} catch (e) {
		console.log('[relation] fetchFollowSearch error name=' + name)
		console.log(e)
		const failed = new PageResult<FollowItem>()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

