/**
 * 黑名单列表（源 BlackHttp.blackList）。
 * 源请求附 csrf 参数；设计 §十口径：先按读-登录态实现（不附 csrf），
 * 接口要求凭据时返回非 0 code，页面给真实错误态。
 */
async function fetchBlacksRaw(pn: number, ps: number): Promise<PageResult<BlackItem>> {
	const result = new PageResult<BlackItem>()
	const params = new Params()
	params.setNum('pn', pn)
	params.setNum('ps', ps)
	params.setNum('re_version', 0)
	const res = await apiGet('/x/relation/blacks', params)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	result.code = codeOf(res)
	if (result.code != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.message = '请求异常'
		return result
	}
	result.total = numOfStrict(data, 'total')
	const list = arrOf(data, 'list')
	for (let i = 0; i < list.length; i++) {
		result.items.push(BlackItem.from(list[i]))
	}
	result.status = true
	return result
}

export async function fetchBlacks(pn: number, ps: number): Promise<PageResult<BlackItem>> {
	try {
