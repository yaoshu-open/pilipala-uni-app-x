/** 稍后再看列表（源 UserHttp.seeYouLater：/x/v2/history/toview，一次全量） */
async function fetchLaterRaw(): Promise<ListResult<HotVideoItem>> {
	const result = new ListResult<HotVideoItem>()
	const res = await apiGet('/x/v2/history/toview', null)
	if (res == null) {
		result.message = '网络异常，请稍后重试'
		return result
	}
	const code = codeOf(res)
	if (code != 0) {
		result.message = messageOf(res)
		return result
	}
	const data = objOf(res, 'data')
	if (data == null) {
		result.message = '数据解析异常，请稍后重试'
		return result
	}
	const list = data.getArray('list')
	if (list != null) {
		for (let i = 0; i < list.length; i++) {
			const raw = list[i]
			if (raw != null) {
				result.items.push(HotVideoItem.from(raw as UTSJSONObject))
			}
		}
	}
	result.status = true
	return result
}

export async function fetchLater(): Promise<ListResult<HotVideoItem>> {
	try {
		return await fetchLaterRaw()
	} catch (e) {
		console.log('[history] fetchLater error')
		console.log(e)
		const failed = new ListResult<HotVideoItem>()
		failed.message = '数据解析异常，请稍后重试'
		return failed
	}
}

// ---------------------------------------------------------------- 写：观看历史

/** 暂停/恢复历史（源 UserHttp.pauseHistory：/x/v2/history/shadow/set） */
export async function historyPauseSet(paused: boolean): Promise<HistoryActionResult> {
	const body: UTSJSONObject = {}
	body.set('switch', paused)
	body.set('jsonp', 'jsonp')
	return postBodyWithCsrf('/x/v2/history/shadow/set', body, paused ? '暂停观看历史' : '恢复观看历史')
}

/** 清空历史（源 UserHttp.clearHistory：/x/v2/history/clear） */
export async function historyClear(): Promise<HistoryActionResult> {
	const params = new Params()
	params.set('jsonp', 'jsonp')
	return postWithCsrf('/x/v2/history/clear', params, '清空观看历史')
}

/** 删除单条历史（源 UserHttp.delHistory：kid 为 `archive_/live_/article_` + kid 拼接，页面走 models/history.uts#historyKidOf） */
export async function historyDelete(kid: string): Promise<HistoryActionResult> {
	const params = new Params()
	params.set('kid', kid)
	params.set('jsonp', 'jsonp')
	return postWithCsrf('/x/v2/history/delete', params, '已删除')
}

// ---------------------------------------------------------------- 写：稍后再看

/** 加入稍后再看（源 UserHttp.toViewLater：bvid；history 条目菜单用） */
export async function laterAdd(bvid: string): Promise<HistoryActionResult> {
	const params = new Params()
	params.set('bvid', bvid)
	return postWithCsrf('/x/v2/history/toview/add', params, 'yeah！稍后再看')
}

/**
 * 移除稍后再看（源 UserHttp.toViewDel）：
 *  - aid 非空：移除单条；
 *  - aid 为空：移除全部已观看（viewed=true，即顶栏「移除已看」）。
 */
export async function laterDel(aid: number): Promise<HistoryActionResult> {
	const body: UTSJSONObject = {}
	body.set('jsonp', 'jsonp')
	if (aid > 0) {
		body.set('aid', aid)
	} else {
		body.set('viewed', true)
	}
	return postBodyWithCsrf('/x/v2/history/toview/del', body, 'yeah！成功移除')
}

/** 清空稍后再看（源 UserHttp.toViewClear：/x/v2/history/toview/clear） */
export async function laterClear(): Promise<HistoryActionResult> {
	const params = new Params()
	params.set('jsonp', 'jsonp')
	return postWithCsrf('/x/v2/history/toview/clear', params, '操作完成')
}
