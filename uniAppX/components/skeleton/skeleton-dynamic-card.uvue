<script setup lang="uts">
import Skeleton from './skeleton.uvue'
import SkeletonBlock from './skeleton-block.uvue'
import { isDarkMode } from '../../utils/theme.uts'

/**
 * 动态卡骨架屏。视觉出处：`lib/common/skeleton/dynamic_card.dart`
 *  - 卡片内边距 left/right/top 12；底部 8px 分隔条（源 Border bottom 8 + dividerColor@0.05）；
 *  - 头部：头像 40×40 圆形、间隔 10、昵称条 100×13（下 5）、副条 50×11；
 *  - 正文（上边距 10）：13px 高条块 ×5，下间距 7，宽度依次 100% / 100% / 300 / 250 / 100；
 *  - 底部操作行：space-around 三组「20 圆形轮廓图标 + 14px 文案（转发/评论/点赞）」，左右各 15 内边距，
 *    前景色 = colorScheme.outline@0.2（目标端取中性灰 20% 透明度近似）。
 */
const actionColor: string = isDarkMode() ? 'rgba(202,198,208,0.2)' : 'rgba(73,69,79,0.2)'
const dividerColor: string = isDarkMode() ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'
</script>

