					<skeleton-block width="100px" height="13px"></skeleton-block>
					<view class="sk-dynamic-gap7"></view>
				</view>
				<view class="sk-dynamic-actions">
					<view class="sk-dynamic-action">
						<view class="sk-dynamic-dot" :style="'border-color:' + actionColor"></view>
						<view class="sk-dynamic-gap8"></view>
						<text class="sk-dynamic-action-text" :style="'color:' + actionColor">转发</text>
					</view>
					<view class="sk-dynamic-action">
						<view class="sk-dynamic-dot" :style="'border-color:' + actionColor"></view>
