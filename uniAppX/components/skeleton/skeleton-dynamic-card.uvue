					</view>
				</view>
				<view class="sk-dynamic-content">
					<skeleton-block height="13px"></skeleton-block>
					<view class="sk-dynamic-gap7"></view>
					<skeleton-block height="13px"></skeleton-block>
					<view class="sk-dynamic-gap7"></view>
					<skeleton-block width="300px" height="13px"></skeleton-block>
					<view class="sk-dynamic-gap7"></view>
					<skeleton-block width="250px" height="13px"></skeleton-block>
