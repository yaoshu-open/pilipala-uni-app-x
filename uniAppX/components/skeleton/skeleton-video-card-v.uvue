<template>
	<view class="sk-card-v">
		<skeleton>
			<skeleton-block width="100%" :height="imgHeight" radius="10px"></skeleton-block>
			<view class="sk-card-v-info">
				<skeleton-block width="200px" height="13px"></skeleton-block>
