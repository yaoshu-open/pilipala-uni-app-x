<template>
	<view class="list-state">
		<view v-if="state === 'loading'" class="list-state-box">
			<view class="list-state-dot-row">
				<view class="list-state-dot list-state-dot-a"></view>
				<view class="list-state-dot list-state-dot-b"></view>
				<view class="list-state-dot list-state-dot-c"></view>
			</view>
			<text class="list-state-text">加载中</text>
		</view>
		<view v-else-if="state === 'empty'" class="list-state-box">
			<text class="list-state-title">暂无内容</text>
			<text class="list-state-text">{{ emptyText }}</text>
		</view>
		<view v-else class="list-state-box">
			<text class="list-state-title">加载失败</text>
			<text class="list-state-text">{{ errorText }}</text>
			<button class="list-state-btn" @click="onRetry">重试</button>
		</view>
	</view>
</template>

<script setup lang="uts">
const props = defineProps({
	state: { type: String, default: 'loading' },
	emptyText: { type: String, default: '' },
	errorText: { type: String, default: '请检查网络后重试' }
})

const emit = defineEmits(['retry'])

function onRetry() {
	emit('retry')
}
</script>

