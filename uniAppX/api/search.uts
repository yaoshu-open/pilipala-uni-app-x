// ---------------------------------------------------------------- 计数 / AV·BV 直达

/** 各类结果计数（源 searchCount：search/all/v2，WBI 签名，web_location=333.999） */
export async function fetchSearchCounts(keyword: string): Promise<SearchCounts | null> {
	const params = new Params()
	params.set('keyword', keyword)
	params.set('web_location', '333.999')
	const res = await wbiGet('/x/web-interface/wbi/search/all/v2', params)
	if (res == null) {
		return null
	}
	const code = res.getNumber('code')
	if (code == null || code != 0) {
		return null
	}
	const dataObj = objOf(res, 'data')
	if (dataObj == null) {
		return null
	}
	return SearchCounts.from(dataObj)
}

/** AV/BV → cid（源 ab2c：/x/player/pagelist 取首分P cid；失败 -1） */
export async function ab2c(aid: number, bvid: string): Promise<number> {
	const params = new Params()
	if (aid > 0) {
		params.setNum('aid', aid)
	} else if (bvid.length > 0) {
		params.set('bvid', bvid)
	} else {
		return -1
	}
	const res = await apiGet('/x/player/pagelist', params)
	if (res == null) {
		return -1
	}
	const code = res.getNumber('code')
	if (code == null || code != 0) {
		return -1
	}
	const rawList = res.getArray('data')
	if (rawList == null || rawList.length == 0) {
		return -1
	}
	try {
		const first = rawList[0] as UTSJSONObject
		const cid = first.getNumber('cid')
		return cid == null ? -1 : cid
	} catch (e) {
		return -1
	}
}

/** AV/BV 号匹配结果（源 IdUtils.matchAvorBv） */
export class AvBvMatch {
	matched: boolean = false
	/** 'BV' | 'AV' | ''（同时命中时以 BV 优先，源 result['BV'] 先写入） */
	kind: string = ''
	bvid: string = ''
	aid: number = 0
}

/** 匹配输入中的 AV/BV 号（源正则：BV=10 位字母数字、AV=纯数字，均不区分大小写） */
export function matchAvorBv(input: string): AvBvMatch {
	const match = new AvBvMatch()
	if (input.length == 0) {
		return match
	}
	const bvIndex = indexOfBv(input)
	if (bvIndex >= 0) {
		match.matched = true
		match.kind = 'BV'
		const raw = input.substring(bvIndex, bvIndex + 12)
		match.bvid = raw.substring(0, 2).toUpperCase() + raw.substring(2)
		return match
	}
	const avIndex = indexOfAv(input)
	if (avIndex >= 0) {
		match.matched = true
		match.kind = 'AV'
		const digits = digitsAfter(input, avIndex + 2)
		if (digits.length == 0) {
			// 'av' 后无数字：不构成 AV 号
			return new AvBvMatch()
		}
		match.aid = parseInt(digits)
	}
	return match
}

/** 找 BV 号起点（[bB][vV] + 10 位字母数字）；无则 -1 */
function indexOfBv(input: string): number {
	for (let i = 0; i + 12 <= input.length; i++) {
		const c1 = input.charAt(i)
		const c2 = input.charAt(i + 1)
		if ((c1 == 'b' || c1 == 'B') && (c2 == 'v' || c2 == 'V')) {
			let valid = true
			for (let j = i + 2; j < i + 12; j++) {
				if (!isAlnum(input.charAt(j))) {
					valid = false
					break
				}
			}
			if (valid) {
				return i
			}
		}
	}
	return -1
}

/** 找 AV 号起点（[aA][vV] + 至少 1 位数字）；无则 -1 */
function indexOfAv(input: string): number {
	for (let i = 0; i + 3 <= input.length; i++) {
		const c1 = input.charAt(i)
		const c2 = input.charAt(i + 1)
		if ((c1 == 'a' || c1 == 'A') && (c2 == 'v' || c2 == 'V')) {
			if (digitsAfter(input, i + 2).length > 0) {
				return i
			}
		}
	}
	return -1
}

function digitsAfter(input: string, start: number): string {
	let text = ''
	for (let i = start; i < input.length; i++) {
		const c = input.charAt(i)
		if (c >= '0' && c <= '9') {
			text += c
		} else {
			break
		}
	}
	return text
}

function isAlnum(c: string): boolean {
	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}
