<template>
	<view class="spd" :style="pageStyle">
		<app-navbar title="倍速设置">
			<template #right>
				<view class="spd-add" @click="openAdd">
					<text class="spd-add-text" :style="addStyle">添加</text>
				</view>
			</template>
		</app-navbar>

		<scroll-view class="spd-scroll" direction="vertical">
			<view class="spd-hint">
				<text class="spd-hint-text" :style="hintStyle">点击下方按钮设置默认（长按）倍速</text>
			</view>

			<setting-cell title="默认倍速" :sub-title="defaultSpeedLabel" mode="arrow" @tap="noop"></setting-cell>
			<setting-cell title="动态长按倍速" sub-title="根据默认倍速长按时自动双倍" mode="switch" :on="autoLongPress" @toggle="onAutoLongPress"></setting-cell>
			<setting-cell v-if="!autoLongPress" title="默认长按倍速" :sub-title="longPressLabel" mode="arrow" @tap="noop"></setting-cell>

			<view class="spd-section">
				<text class="spd-section-title" :style="titleStyle">倍速列表</text>
				<text class="spd-section-sub" :style="hintStyle">点按设为默认倍速；长按弹出操作菜单（上移/下移/设默认/设长按默认/删除）</text>
			</view>

			<view class="spd-chips">
				<view
					v-for="(speed, index) in speeds"
					:key="'s' + index.toString() + '-' + speed.toString()"
					class="spd-chip"
					:style="chipStyle(speed)"
					@click="onChipTap(speed)"
					@longpress="onChipLongPress(speed, index)"
				>
					<text class="spd-chip-text" :style="chipTextStyle(speed)">{{ speedText(speed) }}</text>
					<text v-if="speed == defaultSpeed" class="spd-chip-tag" :style="tagStyle">默</text>
				</view>
			</view>
			<view class="spd-foot" :style="footStyle"></view>
		</scroll-view>

		<!-- 添加倍速弹层（源 AlertDialog+TextField；数字输入 + 校验） -->
		<view v-if="addVisible" class="spd-mask" @click="closeAdd">
			<view class="spd-dialog" :style="dialogStyle" @click.stop="noop">
				<text class="spd-dialog-title" :style="titleStyle">添加倍速</text>
				<input
					class="spd-input"
					:style="inputStyle"
					:value="addText"
					type="digit"
					placeholder="自定义倍速（0.25~5.0）"
					placeholder-class="spd-placeholder"
					@input="onAddInput"
				/>
				<text v-if="addError.length > 0" class="spd-error" :style="errorStyle">{{ addError }}</text>
				<view class="spd-dialog-actions">
					<view class="spd-dialog-btn" @click.stop="closeAdd">
						<text class="spd-dialog-cancel" :style="secondaryStyle">取消</text>
					</view>
					<view class="spd-dialog-btn" @click.stop="confirmAdd">
						<text class="spd-dialog-ok" :style="okStyle">确认添加</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { onBackPress } from '@dcloudio/uni-app'
import AppNavbar from '../../components/app-navbar/app-navbar.uvue'
import SettingCell from '../../components/setting/setting-cell.uvue'
import { pageBackground, cardBackground, textPrimary, textSecondary, themeColor, currentThemeIndex, withAlpha } from '../../utils/theme.uts'
import { safeAreaBottom } from '../../utils/safeArea.uts'
import { SK, getBool, getNumberArray, getNumber, setBool, setNumberArray, setNumber, defaultSpeedList } from '../../utils/storage.uts'

/**
 * 倍速设置（源头：lib/pages/setting/pages/play_speed_set.dart）。
 *
 * 与源的差异（设计文档已拍板的收敛）：源分「系统预设倍速 + 自定义倍速」两组
 * （VideoBoxKey.playSpeedSystem / customSpeedsList 两键），新端收敛为单一
 * SK.playSpeedList（初始 = 源系统预设 0.25~2.0 步进 0.25，generatePlaySpeedList 同款），
 * 增删都在这一张表——P4 倍速菜单只读一个键。
 *
 * 排序：movable-view 拖拽在 uts 未验证（设计文档已标风险），取稳妥方案——
 * 长按菜单里的「上移/下移」按钮排序（源菜单：设默认/设长按默认/删除，新端补两项）。
 *
 * 规则（源 menuAction 同款）：
 *  - 默认倍速档不可删除（toast「默认倍速不可删除」）；
 *  - 删除的档若是长按默认 → 长按默认回落 2.0；
 *  - 动态长按倍速开启时隐藏「默认长按倍速」行与菜单项（源同款）；
 *  - 列表至少保 1 档（全删光等于播放器无倍速可用，禁止）。
 */

const speeds = ref<number[]>(getNumberArray(SK.playSpeedList, defaultSpeedList()))
const defaultSpeed = ref<number>(getNumber(SK.playSpeedDefault, 1.0))
const longPressSpeed = ref<number>(getNumber(SK.playSpeedLongPressDefault, 2.0))
const autoLongPress = ref<boolean>(getBool(SK.enableAutoLongPressSpeed, false))

const addVisible = ref<boolean>(false)
const addText = ref<string>('')
const addError = ref<string>('')

const primary: string = themeColor(currentThemeIndex())
const pageStyle = computed((): string => 'background-color:' + pageBackground() + ';')
const footStyle = computed((): string => 'padding-bottom:' + (safeAreaBottom() + 24).toString() + 'px;')
const dialogStyle: string = 'background-color:' + cardBackground() + ';'
const titleStyle: string = 'color:' + textPrimary() + ';'
const secondaryStyle: string = 'color:' + textSecondary() + ';'
const okStyle: string = 'color:' + primary + ';'
const hintStyle: string = 'color:' + textSecondary() + ';'
const addStyle: string = 'color:' + primary + ';'
const errorStyle: string = 'color:' + primary + ';'
const inputStyle: string = 'color:' + textPrimary() + ';border-color:' + withAlpha(textSecondary(), 0.4) + ';'
const tagStyle: string = 'color:' + primary + ';'

function noop() {}

function speedText(speed: number): string {
	return speed.toString()
}

const defaultSpeedLabel = computed((): string => defaultSpeed.value.toString())
const longPressLabel = computed((): string => longPressSpeed.value.toString())

function chipStyle(speed: number): string {
	if (speed == defaultSpeed.value) {
		return 'background-color:' + withAlpha(primary, 0.14) + ';border-color:' + primary + ';'
	}
	return 'background-color:transparent;border-color:' + withAlpha(textSecondary(), 0.4) + ';'
}

function chipTextStyle(speed: number): string {
	return 'color:' + (speed == defaultSpeed.value ? primary : textPrimary()) + ';'
}

/** 点按 = 设为默认倍速（源长按菜单「设置为默认倍速」的高频路径前移；源点按即弹菜单，新端点按直设+toast） */
function onChipTap(speed: number) {
	defaultSpeed.value = speed
	setNumber(SK.playSpeedDefault, speed)
	uni.showToast({ title: '已设为默认倍速 ' + speed.toString() + 'X', icon: 'none' })
}

function onChipLongPress(speed: number, index: number) {
	const items: string[] = ['上移', '下移', '设置为默认倍速']
	if (!autoLongPress.value) {
		items.push('设置为默认长按倍速')
	}
	items.push('删除该项')
	uni.showActionSheet({
		itemList: items,
		success: (res) => {
			const label = items[res.tapIndex]
			if (label == '上移') {
				moveChip(index, index - 1)
			} else if (label == '下移') {
				moveChip(index, index + 1)
			} else if (label == '设置为默认倍速') {
				onChipTap(speed)
			} else if (label == '设置为默认长按倍速') {
				longPressSpeed.value = speed
				setNumber(SK.playSpeedLongPressDefault, speed)
				uni.showToast({ title: '操作成功', icon: 'none' })
			} else if (label == '删除该项') {
				removeChip(speed)
			}
		}
	})
}

function persistList() {
	setNumberArray(SK.playSpeedList, speeds.value)
}

function moveChip(from: number, to: number) {
	if (to < 0 || to >= speeds.value.length || from == to) {
		return
	}
	const next: number[] = []
	for (let i = 0; i < speeds.value.length; i++) {
		next.push(speeds.value[i])
	}
	const item = next[from]
	next.splice(from, 1)
	next.splice(to, 0, item)
	speeds.value = next
	persistList()
}

/** 删除规则（源同款）：默认档不可删；删的是长按默认则回落 2.0；至少保 1 档 */
function removeChip(speed: number) {
	if (speed == defaultSpeed.value) {
		uni.showToast({ title: '默认倍速不可删除', icon: 'none' })
		return
	}
	if (speeds.value.length <= 1) {
		uni.showToast({ title: '至少保留一个倍速档', icon: 'none' })
		return
	}
	const next: number[] = []
	for (let i = 0; i < speeds.value.length; i++) {
		if (speeds.value[i] != speed) {
			next.push(speeds.value[i])
		}
	}
	speeds.value = next
	if (speed == longPressSpeed.value) {
		longPressSpeed.value = 2.0
		setNumber(SK.playSpeedLongPressDefault, 2.0)
	}
	persistList()
	uni.showToast({ title: '操作成功', icon: 'none' })
}

function onAutoLongPress(value: boolean) {
	setBool(SK.enableAutoLongPressSpeed, value)
	autoLongPress.value = value
}

// ---------------------------------------------------------------- 添加弹层

function openAdd() {
	addText.value = ''
	addError.value = ''
	addVisible.value = true
}

function closeAdd() {
	addVisible.value = false
}

function onAddInput(event: UniInputEvent) {
	addText.value = event.detail.value
}

function confirmAdd() {
	const raw = addText.value.trim()
	if (raw.length == 0) {
		addError.value = '请输入倍速值'
		return
	}
	const parsed = parseFloat(raw)
	if (isNaN(parsed)) {
		addError.value = '请输入有效数字'
		return
	}
	if (parsed < 0.25 || parsed > 5.0) {
		addError.value = '倍速范围 0.25 ~ 5.0'
		return
	}
	const value = Math.round(parsed * 100) / 100
	for (let i = 0; i < speeds.value.length; i++) {
		if (speeds.value[i] == value) {
			addError.value = '该倍速已存在'
			return
		}
	}
	// 有序插入（升序），保持列表可预期（源 Wrap 无序展示，新端收敛为有序）
	const next: number[] = []
	let inserted = false
	for (let i = 0; i < speeds.value.length; i++) {
		if (!inserted && value < speeds.value[i]) {
			next.push(value)
			inserted = true
		}
		next.push(speeds.value[i])
	}
	if (!inserted) {
		next.push(value)
	}
	speeds.value = next
	persistList()
	addVisible.value = false
	uni.showToast({ title: '已添加 ' + value.toString() + 'X', icon: 'none' })
}

onBackPress(() => {
	if (addVisible.value) {
		closeAdd()
		return true
	}
	return false
})
</script>

<style>
	.spd {
		flex: 1;
		display: flex;
		flex-direction: column;
		position: relative;
	}
	.spd-scroll {
		flex: 1;
	}
	.spd-hint {
		padding-left: 16px;
		padding-right: 16px;
		padding-top: 6px;
	}
	.spd-hint-text {
		font-size: 12px;
	}
	.spd-add {
		min-height: 56px;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 10px;
		padding-right: 10px;
	}
	.spd-add-text {
		font-size: 15px;
	}
	.spd-section {
		padding-left: 16px;
		padding-right: 16px;
		padding-top: 20px;
		padding-bottom: 10px;
		display: flex;
		flex-direction: column;
	}
	.spd-section-title {
		font-size: 16px;
		font-weight: bold;
	}
	.spd-section-sub {
		font-size: 11px;
		line-height: 17px;
		margin-top: 4px;
	}
	/* 倍速 chips：flex-wrap 逐行铺（源 Wrap 等价；App 端 flex-wrap 可用） */
	.spd-chips {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		padding-left: 16px;
		padding-right: 16px;
	}
	.spd-chip {
		min-width: 64px;
		height: 40px;
		border-radius: 8px;
		border-width: 1px;
		border-style: solid;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-right: 10px;
		margin-bottom: 10px;
		padding-left: 12px;
		padding-right: 12px;
	}
	.spd-chip-text {
		font-size: 14px;
	}
	.spd-chip-tag {
		font-size: 10px;
		margin-left: 4px;
	}
	.spd-foot {
		height: 1px;
	}
	/* 添加弹层 */
	.spd-mask {
		position: absolute;
		left: 0;
		top: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.4);
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}
	.spd-dialog {
		width: 300px;
		border-radius: 14px;
		padding-left: 20px;
		padding-right: 20px;
		padding-top: 20px;
		padding-bottom: 10px;
		display: flex;
		flex-direction: column;
	}
	.spd-dialog-title {
		font-size: 17px;
		font-weight: bold;
	}
	.spd-input {
		height: 44px;
		border-width: 1px;
		border-style: solid;
		border-radius: 8px;
		padding-left: 10px;
		padding-right: 10px;
		margin-top: 16px;
		font-size: 14px;
	}
	.spd-placeholder {
		color: #B9BEC8;
		font-size: 14px;
	}
	.spd-error {
		font-size: 12px;
		margin-top: 8px;
	}
	.spd-dialog-actions {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}
	.spd-dialog-btn {
		min-height: 44px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding-left: 14px;
	}
	.spd-dialog-cancel {
		font-size: 14px;
	}
	.spd-dialog-ok {
		font-size: 14px;
		font-weight: bold;
	}
</style>
