export class LivePlayResult {
	status: boolean = false
	message: string = ''
	data: LivePlayData | null = null
}

/** H5 房间信息结果 */
export class LiveH5Result {
	status: boolean = false
	message: string = ''
	data: LiveRoomH5 | null = null
}

/** 弹幕连接信息结果 */
export class LiveDanmakuInfoResult {
	status: boolean = false
	message: string = ''
	data: LiveDanmakuInfo | null = null
}
